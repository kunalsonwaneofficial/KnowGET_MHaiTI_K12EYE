// KnowGET MHaiTI — Enterprise Data Platform (P1-M03) + Phase-2 domain tables.
// Prisma is an infrastructure implementation detail; domains depend on the
// @knowget/persistence abstractions, never on this client directly.
// Platform tables (P1) and per-domain tables (P2+) live here; every
// tenant-owned table enables FORCE Row-Level Security (see the RLS migrations).

generator client {
  provider = "prisma-client-js"
  // "native" for local/CI; the musl target lets the client run on Alpine-based
  // container images (P1-M06 / resolves TD-15).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform audit trail (platform auditing — not business audit reporting).
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  actorId       String?  @map("actor_id") @db.Uuid
  correlationId String?  @map("correlation_id")
  data          Json?
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

/// Platform data-platform verification fixture — exercises the reusable
/// repository, transactions, soft delete and tenant (RLS) isolation. It is NOT
/// a business entity; it is the concrete surface the data platform is tested on.
model DataProbe {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  value         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  correlationId String?   @map("correlation_id")
  deletedAt     DateTime? @map("deleted_at")

  @@index([tenantId])
  @@map("data_probe")
}

/// Organization domain (P2-D01-M01) — a node in the institution's hierarchy
/// (trust/society → school → campus → department → grade → section). Structure
/// only; membership and people arrive in later Identity & Organization contracts.
/// Tenant-owned: FORCE RLS isolates every row (see the add_organization migration).
model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  type      String
  name      String
  code      String
  status    String    @default("draft")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("organization")
}

/// Person domain (P2-D01-M02) — the persona-agnostic canonical human record.
/// Contacts are an embedded value-object collection (JSONB); `match_key` is a
/// deterministic dedup key (family|given|dob). Tenant-owned: FORCE RLS isolates
/// every row (see the add_person migration).
model Person {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  givenName     String    @map("given_name")
  familyName    String    @map("family_name")
  middleName    String?   @map("middle_name")
  preferredName String?   @map("preferred_name")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        String    @default("unspecified")
  status        String    @default("active")
  contacts      Json      @default("[]")
  matchKey      String    @map("match_key")
  mergedInto    String?   @map("merged_into") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, matchKey])
  @@map("person")
}

/// Enterprise Identity domain (P2-D01-M03) — a tenant-scoped login account that
/// links a Person (`person_id`) to the identifiers and credential they
/// authenticate with, plus status and failed-login lockout counters. Identifiers
/// are an embedded JSONB value-object collection; `identifier_keys` is a
/// normalized, GIN-indexed lookup array powering tenant-scoped identifier
/// resolution. Tenant-owned: FORCE RLS isolates every row (see the
/// add_identity_account migration).
model IdentityAccount {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  personId            String    @map("person_id") @db.Uuid
  identifiers         Json      @default("[]")
  identifierKeys      String[]  @map("identifier_keys")
  credentialHash      String?   @map("credential_hash")
  status              String    @default("pending")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, personId])
  // The normalized identifier lookup is served by a GIN index on
  // `identifier_keys`, created in the add_identity_account migration (like RLS,
  // it is a migration-only DB feature not expressible in the Prisma schema).
  @@map("identity_account")
}

/// Membership domain (P2-D01-M04) — a person's affiliation with an organization
/// node, carrying the role names they play there, a status and an effective
/// period. The join across Person and Organization; role names are opaque (their
/// permissions are resolved by the authorization engine). Tenant-owned: FORCE RLS
/// isolates every row (see the add_membership migration).
model Membership {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  personId       String    @map("person_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roles          String[]
  status         String    @default("active")
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, personId])
  @@index([tenantId, organizationId])
  @@map("membership")
}
