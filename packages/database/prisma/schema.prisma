  subjectId                 String    @map("subject_id") @db.Uuid
  unitPlanId                String?   @map("unit_plan_id") @db.Uuid
  title                     String
  objectives                Json      @default("[]")
  learningOutcomeIds        Json      @default("[]") @map("learning_outcome_ids")
  teachingStrategies        Json      @default("[]") @map("teaching_strategies")
  learningActivities        Json      @default("[]") @map("learning_activities")
  assessmentCheckpoints     Json      @default("[]") @map("assessment_checkpoints")
  requiredResourceIds       Json      @default("[]") @map("required_resource_ids")
  differentiationStrategies Json      @default("[]") @map("differentiation_strategies")
  reflectionNotes           String?   @map("reflection_notes")
  version                   Int       @default(1)
  status                    String    @default("draft")
  revisions                 Json      @default("[]")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  createdBy                 String?   @map("created_by") @db.Uuid
  updatedBy                 String?   @map("updated_by") @db.Uuid
  deletedAt                 DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, subjectId])
  @@index([tenantId, unitPlanId])
  @@map("lesson_plan")
}

/// LearningResource (P2-D09) — a version-controlled, tagged, curriculum-mapped library item
