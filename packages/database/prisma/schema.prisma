  learningOutcomeIds          Json      @default("[]") @map("learning_outcome_ids")
  competencies                Json      @default("[]")
  estimatedInstructionalHours Float     @default(0) @map("estimated_instructional_hours")
  assessmentStrategy          String?   @map("assessment_strategy")
  status                      String    @default("draft")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  createdBy                   String?   @map("created_by") @db.Uuid
  updatedBy                   String?   @map("updated_by") @db.Uuid
  deletedAt                   DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, subjectId])
  @@map("unit_plan")
}

/// LessonPlan (P2-D09) — the version-controlled design of a lesson with a review/approval
/// workflow (draft → in_review → approved → archived). Tenant-owned: FORCE RLS.
model LessonPlan {
