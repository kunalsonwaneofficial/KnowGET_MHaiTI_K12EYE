  counsellorId      String    @map("counsellor_id") @db.Uuid
  presentingConcern String    @map("presenting_concern")
  priority          String    @default("normal")
  status            String    @default("open")
  sessions          Json      @default("[]")
  referrals         Json      @default("[]")
  goals             Json      @default("[]")
  outcome           String?
  openedAt          DateTime  @map("opened_at")
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, counsellorId])
  @@index([tenantId, organizationId])
  @@map("counselling_case")
}

/// Safeguarding case (P2-D05) — child-protection concern, incident reports, risk
