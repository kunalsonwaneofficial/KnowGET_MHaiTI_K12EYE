  @@index([tenantId, organizationId])
  @@index([tenantId, status])
  @@index([tenantId, subjectDomain, subjectId])
  @@map("decision_recommendation")
}

/// DecisionRecord (P2-D27) — the answer to a recommendation and everything that followed from it: who was
/// accountable, the gate's reason codes as they stood, the evidence ids the decision rested on, and how the
/// authorized act settled. `action` is null when the decision authorizes nothing — a judgement, not an act.
/// `compensation_state` is derived by the reversal engine, never asserted by a caller. Never deleted.
/// Tenant-owned: FORCE RLS.
model DecisionRecord {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
