  @@index([tenantId, agentId])
  @@index([tenantId, status])
  @@map("reasoning_session")
}

// ============================================================================
// P2-D27 — Institutional Decision Intelligence, Workflow Orchestration &
// Autonomous Operations
// The decision layer of the intelligence core (Program E), built on the AI
// runtime P2-D26 laid down. Three rules are structural here rather than
// procedural: only low-risk actions may execute unattended, every
// recommendation carries the evidence chain it stands on, and anything
// automation does keeps a way back until it is taken. Recommendations,
// decisions, cases and firings are the record of what was proposed, decided,
// done and undone — none of them has a delete path anywhere above it. Only
// definitions (a workflow version, a rule) can be taken away.
// All tenant-isolated by FORCE RLS.
// ============================================================================

/// DecisionRecommendation (P2-D27) — an institutional recommendation about a subject in another domain,
/// carrying the evidence chain it stands on (`evidence` JSONB) and the confidence derived from that chain's
/// weakest link; proposed -> accepted | rejected | superseded | expired | withdrawn. Named for the contract
/// rather than plainly, because `recommendation` is P2-D11's learner-scoped suggestion — a different thing
/// about a different subject. Never deleted: a rejection is the record that somebody looked and said no.
/// Tenant-owned: FORCE RLS.
model DecisionRecommendation {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  title                  String
  summary                String?
  subjectDomain          String   @map("subject_domain")
  subjectId              String   @map("subject_id")
  impactBand             String   @map("impact_band")
  riskLevel              String   @map("risk_level")
  requiresHumanJudgement Boolean  @default(false) @map("requires_human_judgement")
  status                 String   @default("proposed")
  evidence               Json     @default("[]")
  confidence             Int      @default(0)
  proposedByUserId       String?  @map("proposed_by_user_id") @db.Uuid
  raisedByRuleId         String?  @map("raised_by_rule_id") @db.Uuid
  resolvedByUserId       String?  @map("resolved_by_user_id") @db.Uuid
  resolvedAt             String?  @map("resolved_at")
  resolutionNote         String?  @map("resolution_note")
  supersededById         String?  @map("superseded_by_id") @db.Uuid
  expiresAt              String?  @map("expires_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
