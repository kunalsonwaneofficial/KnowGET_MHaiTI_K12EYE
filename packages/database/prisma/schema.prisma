  updatedBy            String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, recommendationId])
  @@index([tenantId, compensationState])
  @@map("decision_record")
}

/// WorkflowDefinition (P2-D27) — one version of a named institutional process. A key does not identify a
/// workflow; a key and a version do, because revising a published process creates a new draft beside it rather
/// than editing the one cases are running under — hence the unique on (tenant, key, version) and no unique on
/// key alone. `stages` holds the ordered stage list (dependencies, risk, reversibility, SLA, assignee role) as
/// part of the aggregate, loaded and saved whole: soundness is a property across stages, unenforceable from a
/// row that can be written on its own. Draft versions are discardable. Tenant-owned: FORCE RLS.
model WorkflowDefinition {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
