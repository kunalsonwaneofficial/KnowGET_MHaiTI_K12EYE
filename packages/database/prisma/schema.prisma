  organizationId   String    @map("organization_id") @db.Uuid
  studentId        String    @map("student_id") @db.Uuid
  concern          String
  category         String
  riskLevel        String    @default("medium") @map("risk_level")
  status           String    @default("reported")
  reportedBy       String    @map("reported_by") @db.Uuid
  incidentReports  Json      @default("[]") @map("incident_reports")
  escalations      Json      @default("[]")
  externalAgencies Json      @default("[]") @map("external_agencies")
  resolution       String?
  openedAt         DateTime  @map("opened_at")
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, organizationId])
  @@map("safeguarding_case")
}

/// Learner support plan (P2-D05) — the individual education/inclusion plan: academic and
