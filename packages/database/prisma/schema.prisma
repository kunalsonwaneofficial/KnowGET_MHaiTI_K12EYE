  @@index([tenantId, status])
  @@index([tenantId, signalKey, status])
  @@map("automation_rule")
}

/// AutomationRun (P2-D27) — one firing of one rule: the gate's verdict and its reason codes, taken before this
/// record existed, the action as it stood, and the operands of the comparisons the rule actually made
/// (`observed_facts` — never the whole signal payload). Who approved a referred firing, or refused it, is here
/// too. `compensation_state` is derived by the reversal engine from the action and how far execution got.
/// Never deleted — the record of what the platform did while nobody was watching is exactly what must not be
/// deletable. Tenant-owned: FORCE RLS.
model AutomationRun {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
