/// reads; active -> completed | discontinued. No money (drug cost -> P2-D15). Tenant-owned: FORCE RLS.
model Prescription {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  centreId          String    @map("centre_id") @db.Uuid
  patientId         String    @map("patient_id") @db.Uuid
  clinicianId       String    @map("clinician_id") @db.Uuid
  medication        String
  dosage            String?
  frequencyPerDay   Int       @map("frequency_per_day")
  durationDays      Int       @map("duration_days")
  dosesAdministered Int       @default(0) @map("doses_administered")
  startDate         String    @map("start_date")
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, centreId])
  @@index([tenantId, patientId])
  @@index([tenantId, organizationId])
  @@map("prescription")
}

/// SickBayAdmission (P2-D19) — a patient in a sick-bay bed for observation; active -> discharged. Active
/// admissions are what the occupancy engine counts against capacity; one active per bed and one per patient
/// are service-enforced (TD-39). Tenant-owned: FORCE RLS.
model SickBayAdmission {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  centreId       String    @map("centre_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  bedLabel       String    @map("bed_label")
  admittedOn     String    @map("admitted_on")
  reason         String?
  dischargedOn   String?   @map("discharged_on")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, centreId])
  @@index([tenantId, patientId])
  @@index([tenantId, organizationId])
  @@map("sick_bay_admission")
}

/// Referral (P2-D19) — a health centre's onward referral of a patient to an external provider (target,
/// urgency, optional reason held off events); raised -> accepted -> completed | cancelled. Tenant-owned:
/// FORCE RLS.
model Referral {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  centreId       String    @map("centre_id") @db.Uuid
  patientId      String    @map("patient_id") @db.Uuid
  clinicianId    String?   @map("clinician_id") @db.Uuid
  referredTo     String    @map("referred_to")
  urgency        String
  reason         String?
  raisedOn       String    @map("raised_on")
  status         String    @default("raised")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, centreId])
  @@index([tenantId, patientId])
  @@index([tenantId, organizationId])
  @@map("referral")
}

/// CentreProfile (P2-D19) — the descriptive read model per centre (sick-bay occupancy via the occupancy
/// engine; open appointment/encounter/referral, active + overdue prescription counts), refreshed
/// (version-bumped); one per centre. Tenant-owned: FORCE RLS.
model CentreProfile {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  organizationId           String    @map("organization_id") @db.Uuid
  centreId                 String    @map("centre_id") @db.Uuid
  centreCode               String    @map("centre_code")
  sickBayCapacity          Int       @default(0) @map("sick_bay_capacity")
  activeAdmissionCount     Int       @default(0) @map("active_admission_count")
  bedsAvailable            Int       @default(0) @map("beds_available")
  occupancyPercent         Int       @default(0) @map("occupancy_percent")
  overCapacity             Boolean   @default(false) @map("over_capacity")
  openAppointmentCount     Int       @default(0) @map("open_appointment_count")
  openEncounterCount       Int       @default(0) @map("open_encounter_count")
  activePrescriptionCount  Int       @default(0) @map("active_prescription_count")
  overduePrescriptionCount Int       @default(0) @map("overdue_prescription_count")
  openReferralCount        Int       @default(0) @map("open_referral_count")
  version                  Int       @default(1)
  refreshedAt              String?   @map("refreshed_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  createdBy                String?   @map("created_by") @db.Uuid
  updatedBy                String?   @map("updated_by") @db.Uuid
  deletedAt                DateTime? @map("deleted_at")

  @@unique([tenantId, centreId])
  @@index([tenantId])
  @@map("centre_profile")
}

/// Building (P2-D20) — an immovable structure on the campus (academic/administrative/laboratory/sports/
/// library/utility/multipurpose) with a floor count; active <-> under_renovation -> decommissioned, code
/// unique per tenant. The built environment, not the capitalized asset (P2-D15). Tenant-owned: FORCE RLS.
model Building {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  type           String
  floors         Int       @default(0)
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("building")
}

/// Space (P2-D20) — a room or area within a building (classroom/laboratory/office/hall/storage/restroom/
/// common) with a floor and a usable capacity; draft -> available <-> out_of_service -> decommissioned,
/// code unique per building. Available capacity feeds the condition engine. Tenant-owned: FORCE RLS.
model Space {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  buildingId     String    @map("building_id") @db.Uuid
  code           String
  type           String
  floor          Int       @default(0)
  capacity       Int       @default(0)
  status         String    @default("draft")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, buildingId, code])
  @@index([tenantId])
  @@index([tenantId, buildingId])
  @@index([tenantId, organizationId])
  @@map("space")
}

/// FacilitySystem (P2-D20) — a building's fixed infrastructure system (hvac/electrical/plumbing/elevator/
/// fire_safety/network/water) with a service interval and last-serviced date; operational <->
/// under_maintenance -> decommissioned, code unique per building. Service status is derived. No money
/// (capital value -> P2-D15). Tenant-owned: FORCE RLS.
model FacilitySystem {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  buildingId          String    @map("building_id") @db.Uuid
  code                String
  type                String
  commissionedOn      String    @map("commissioned_on")
  serviceIntervalDays Int       @map("service_interval_days")
  lastServicedOn      String?   @map("last_serviced_on")
  status              String    @default("operational")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at")

  @@unique([tenantId, buildingId, code])
  @@index([tenantId])
  @@index([tenantId, buildingId])
  @@index([tenantId, organizationId])
  @@map("facility_system")
}

/// Sensor (P2-D20) — a smart-environment device in a space reading one metric (temperature/humidity/co2/
/// occupancy/energy/water); active <-> inactive -> retired, code unique per tenant, one active per
/// (space, metric) service-enforced (TD-40). Org/building derived from the space. Tenant-owned: FORCE RLS.
model Sensor {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  buildingId     String    @map("building_id") @db.Uuid
  spaceId        String    @map("space_id") @db.Uuid
  code           String
  metric         String
  unit           String?
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, spaceId])
  @@index([tenantId, buildingId])
  @@index([tenantId, organizationId])
  @@map("sensor")
}

/// EnvironmentReading (P2-D20) — an immutable telemetry fact: one numeric sample of a metric by a sensor in
/// a space at a moment. `value` is FLOAT (a physical measurement, never money). The latest per (space,
/// metric) feeds the comfort engine. Append-only. Tenant-owned: FORCE RLS.
model EnvironmentReading {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  buildingId     String    @map("building_id") @db.Uuid
  spaceId        String    @map("space_id") @db.Uuid
  sensorId       String    @map("sensor_id") @db.Uuid
  metric         String
  value          Float
  unit           String?
  recordedAt     String    @map("recorded_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, spaceId])
  @@index([tenantId, sensorId])
  @@index([tenantId, organizationId])
  @@map("environment_reading")
}

/// MaintenanceOrder (P2-D20) — an operational work order against a building (optionally a space and/or
/// system): category, priority, optional Employee assignee (P2-D12); reported -> assigned -> in_progress ->
/// completed | cancelled, code unique per tenant. No money (costed asset maintenance -> P2-D15).
/// Tenant-owned: FORCE RLS.
model MaintenanceOrder {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  buildingId     String    @map("building_id") @db.Uuid
  spaceId        String?   @map("space_id") @db.Uuid
  systemId       String?   @map("system_id") @db.Uuid
  code           String
  summary        String
  category       String
  priority       String
  status         String    @default("reported")
  assigneeId     String?   @map("assignee_id") @db.Uuid
  reportedOn     String    @map("reported_on")
  assignedOn     String?   @map("assigned_on")
  completedOn    String?   @map("completed_on")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, buildingId])
  @@index([tenantId, organizationId])
  @@index([tenantId, assigneeId])
  @@map("maintenance_order")
}

/// ComfortPolicy (P2-D20) — a named, versioned set of per-metric acceptable ranges (JSONB `thresholds`) the
/// comfort engine measures a space against; draft -> active -> archived, at most one active per organization
/// service-enforced (TD-40). Configuration, never money. Tenant-owned: FORCE RLS.
model ComfortPolicy {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  version        Int       @default(1)
  thresholds     Json      @default("[]")
  status         String    @default("draft")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("comfort_policy")
}

/// FacilityProfile (P2-D20) — the descriptive read model per building: condition counts/capacities and
/// readiness percent (from the condition engine) plus the open-maintenance count, refreshed; one per
/// building. Holds no truth of its own. Tenant-owned: FORCE RLS.
model FacilityProfile {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                String    @map("tenant_id") @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  buildingId              String    @map("building_id") @db.Uuid
  buildingCode            String    @map("building_code")
  buildingName            String    @map("building_name")
  buildingStatus          String    @map("building_status")
  spaceCount              Int       @default(0) @map("space_count")
  availableSpaceCount     Int       @default(0) @map("available_space_count")
  outOfServiceSpaceCount  Int       @default(0) @map("out_of_service_space_count")
  totalCapacity           Int       @default(0) @map("total_capacity")
  availableCapacity       Int       @default(0) @map("available_capacity")
  systemCount             Int       @default(0) @map("system_count")
  operationalSystemCount  Int       @default(0) @map("operational_system_count")
  systemsUnderMaintenance Int       @default(0) @map("systems_under_maintenance")
  readinessPercent        Int       @default(0) @map("readiness_percent")
  openMaintenanceCount    Int       @default(0) @map("open_maintenance_count")
  refreshedAt             String    @map("refreshed_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  createdBy               String?   @map("created_by") @db.Uuid
  updatedBy               String?   @map("updated_by") @db.Uuid
  deletedAt               DateTime? @map("deleted_at")

  @@unique([tenantId, buildingId])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("facility_profile")
}

/// AccessZone (P2-D21) — a controlled area with a security level (public/restricted/secure/high_security)
/// and an optional safe-occupancy capacity; active <-> locked_down -> decommissioned, code unique per
/// tenant. A security abstraction scoped to an organization. Tenant-owned: FORCE RLS.
model AccessZone {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  securityLevel  String    @map("security_level")
  capacity       Int       @default(0)
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("access_zone")
}

/// Visitor (P2-D21) — a known campus visitor (guest/parent/vendor/contractor/official) with optional
/// contact details; active <-> blocked -> archived, code unique per tenant. Contact is held here, never on
/// an event. Tenant-owned: FORCE RLS.
model Visitor {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  fullName       String    @map("full_name")
  type           String
  phone          String?
  email          String?
  company        String?
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("visitor")
}

/// Visit (P2-D21) — a visitor's trip to see a host (a Person) bound for a zone; requested -> approved ->
/// checked_in -> checked_out | denied | cancelled | expired. A checked-in visit is what the presence engine
/// counts as on-site; the purpose is held here, never on an event. Tenant-owned: FORCE RLS.
model Visit {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  visitorId      String    @map("visitor_id") @db.Uuid
  hostPersonId   String    @map("host_person_id") @db.Uuid
  zoneId         String?   @map("zone_id") @db.Uuid
  purpose        String?
  scheduledFor   String    @map("scheduled_for")
  status         String    @default("requested")
  checkedInAt    String?   @map("checked_in_at")
  checkedOutAt   String?   @map("checked_out_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, visitorId])
  @@index([tenantId, zoneId])
  @@index([tenantId, hostPersonId])
  @@index([tenantId, organizationId])
  @@map("visit")
}

/// AccessCredential (P2-D21) — a badge for an employee/person/visitor holder granting a JSONB set of zone
/// ids; active <-> suspended -> revoked, credential number unique per tenant, optional expiry. Tenant-owned:
/// FORCE RLS.
model AccessCredential {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  credentialNumber String    @map("credential_number")
  holderType       String    @map("holder_type")
  holderId         String    @map("holder_id") @db.Uuid
  grantedZoneIds   Json      @default("[]") @map("granted_zone_ids")
  issuedOn         String    @map("issued_on")
  expiresOn        String?   @map("expires_on")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  @@unique([tenantId, credentialNumber])
  @@index([tenantId])
  @@index([tenantId, holderType, holderId])
  @@index([tenantId, organizationId])
  @@map("access_credential")
}

/// AccessEvent (P2-D21) — an immutable, append-only record of one access decision: a credential at a zone,
/// the decision and reason code. No lifecycle, feeds the access-activity engine. Tenant-owned: FORCE RLS.
model AccessEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  credentialId   String    @map("credential_id") @db.Uuid
  zoneId         String    @map("zone_id") @db.Uuid
  pointLabel     String?   @map("point_label")
  decision       String
  reason         String
  occurredAt     String    @map("occurred_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, credentialId])
  @@index([tenantId, zoneId])
  @@index([tenantId, organizationId])
  @@map("access_event")
}

/// SecurityIncident (P2-D21) — an operational security/safety event (theft/trespass/…/lost_found) at an
/// optional zone, with a category, severity, optional Person reporter and Employee assignee; reported ->
/// triaged -> investigating -> resolved -> closed | cancelled, code unique per tenant. The summary is held
/// here, never on an event. Tenant-owned: FORCE RLS.
model SecurityIncident {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  code               String
  category           String
  severity           String
  zoneId             String?   @map("zone_id") @db.Uuid
  reportedByPersonId String?   @map("reported_by_person_id") @db.Uuid
  assigneeId         String?   @map("assignee_id") @db.Uuid
  summary            String
  reportedOn         String    @map("reported_on")
  resolvedOn         String?   @map("resolved_on")
  status             String    @default("reported")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  deletedAt          DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, zoneId])
  @@index([tenantId, assigneeId])
  @@index([tenantId, organizationId])
  @@map("security_incident")
}

/// EmergencyDrill (P2-D21) — a planned safety exercise (fire/lockdown/evacuation/earthquake/
/// shelter_in_place) for a zone or the site, with an expected roster and an accounted-for muster; scheduled
/// -> in_progress -> completed | cancelled, code unique per tenant. The unaccounted-for count is derived.
/// Tenant-owned: FORCE RLS.
model EmergencyDrill {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  type           String
  zoneId         String?   @map("zone_id") @db.Uuid
  conductedById  String?   @map("conducted_by_id") @db.Uuid
  scheduledFor   String    @map("scheduled_for")
  expectedCount  Int       @default(0) @map("expected_count")
  accountedCount Int       @default(0) @map("accounted_count")
  startedAt      String?   @map("started_at")
  completedAt    String?   @map("completed_at")
  status         String    @default("scheduled")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, zoneId])
  @@index([tenantId, organizationId])
  @@map("emergency_drill")
}

/// SafetyProfile (P2-D21) — the descriptive read model per zone: on-site visitor presence (with an
/// over-capacity flag), open-incident and active-credential counts, and granted/denied access activity,
/// refreshed; one per zone. Holds no truth of its own. Tenant-owned: FORCE RLS.
model SafetyProfile {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  zoneId                String    @map("zone_id") @db.Uuid
  zoneCode              String    @map("zone_code")
  zoneName              String    @map("zone_name")
  securityLevel         String    @map("security_level")
  zoneStatus            String    @map("zone_status")
  capacity              Int       @default(0)
  onSiteVisitorCount    Int       @default(0) @map("on_site_visitor_count")
  available             Int       @default(0)
  overCapacity          Boolean   @default(false) @map("over_capacity")
  occupancyPercent      Int       @default(0) @map("occupancy_percent")
  openIncidentCount     Int       @default(0) @map("open_incident_count")
  activeCredentialCount Int       @default(0) @map("active_credential_count")
  accessGrantedCount    Int       @default(0) @map("access_granted_count")
  accessDeniedCount     Int       @default(0) @map("access_denied_count")
  refreshedAt           String    @map("refreshed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  deletedAt             DateTime? @map("deleted_at")

  @@unique([tenantId, zoneId])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("safety_profile")
}

// ---------------------------------------------------------------------------------
// P2-D22 — Unified Communication, Engagement & Collaboration Platform
// ---------------------------------------------------------------------------------

/// Audience (P2-D22) — a reusable recipient group (code unique per tenant) holding an opaque JSONB set of
/// member Person ids and an optional criteria label; active -> archived. Member ids are not per-item
/// validated (the organization is the anchor). Tenant-owned: FORCE RLS.
model Audience {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  code            String
  name            String
  description     String?
  criteriaLabel   String?   @map("criteria_label")
  memberPersonIds Json      @default("[]") @map("member_person_ids")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("audience")
}

/// Announcement (P2-D22) — an institution->audience broadcast (title/body/category/priority);
/// draft -> scheduled -> published -> archived | cancelled, pinned while published. Delivery to channels is
/// the platform notifications service's (P1-M05). Tenant-owned: FORCE RLS.
model Announcement {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  audienceId     String    @map("audience_id") @db.Uuid
  authorPersonId String    @map("author_person_id") @db.Uuid
  title          String
  body           String
  category       String
  priority       String    @default("normal")
  status         String    @default("draft")
  pinned         Boolean   @default(false)
  scheduledFor   String?   @map("scheduled_for")
  publishedAt    String?   @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, audienceId])
  @@index([tenantId, organizationId])
  @@map("announcement")
}

/// AcknowledgementReceipt (P2-D22) — an immutable, append-only record that a person acknowledged a published
/// announcement. One per (announcement, person), DB-backed. No lifecycle. Tenant-owned: FORCE RLS.
model AcknowledgementReceipt {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  announcementId String    @map("announcement_id") @db.Uuid
  personId       String    @map("person_id") @db.Uuid
  acknowledgedAt String    @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, announcementId, personId])
  @@index([tenantId])
  @@index([tenantId, announcementId])
  @@map("acknowledgement_receipt")
}

/// MessageThread (P2-D22) — a two-way / group conversation on a subject among a JSONB set of participant
/// Person ids; open <-> closed -> archived. Messages are the separate immutable log. Tenant-owned: FORCE RLS.
model MessageThread {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  subject              String
  participantPersonIds Json      @default("[]") @map("participant_person_ids")
  status               String    @default("open")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  createdBy            String?   @map("created_by") @db.Uuid
  updatedBy            String?   @map("updated_by") @db.Uuid
  deletedAt            DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("message_thread")
}

/// Message (P2-D22) — an immutable, append-only entry in a thread (author, body, sentAt). No lifecycle. The
/// body is held here, never on an event. Tenant-owned: FORCE RLS.
model Message {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  threadId       String    @map("thread_id") @db.Uuid
  authorPersonId String    @map("author_person_id") @db.Uuid
  body           String
  sentAt         String    @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, threadId])
  @@map("message")
}

/// Survey (P2-D22) — a feedback / poll / consent-check instrument targeting an audience, carrying a validated
/// JSONB question set; draft -> open -> closed -> archived. Tenant-owned: FORCE RLS.
model Survey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  audienceId     String    @map("audience_id") @db.Uuid
  title          String
  type           String
  questions      Json      @default("[]")
  status         String    @default("draft")
  opensAt        String?   @map("opens_at")
  closesAt       String?   @map("closes_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, audienceId])
  @@index([tenantId, organizationId])
  @@map("survey")
}

/// SurveyResponse (P2-D22) — an immutable, append-only submission (optional respondent for anonymity; JSONB
/// answers). One identified response per (survey, respondent) is DB-backed; NULL respondents (anonymous) are
/// distinct, so anonymous responses are unbounded. No lifecycle. Tenant-owned: FORCE RLS.
model SurveyResponse {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  surveyId           String    @map("survey_id") @db.Uuid
  respondentPersonId String?   @map("respondent_person_id") @db.Uuid
  answers            Json      @default("[]")
  submittedAt        String    @map("submitted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  deletedAt          DateTime? @map("deleted_at")

  @@unique([tenantId, surveyId, respondentPersonId])
  @@index([tenantId])
  @@index([tenantId, surveyId])
  @@map("survey_response")
}

/// EngagementProfile (P2-D22) — a descriptive, re-derivable per-audience read model (reach + response
/// metrics), refreshed from the two engines. One per audience. Tenant-owned: FORCE RLS.
model EngagementProfile {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  audienceId             String    @map("audience_id") @db.Uuid
  audienceCode           String    @map("audience_code")
  audienceName           String    @map("audience_name")
  audienceSize           Int       @default(0) @map("audience_size")
  announcementCount      Int       @default(0) @map("announcement_count")
  totalAcknowledged      Int       @default(0) @map("total_acknowledged")
  acknowledgementPercent Int       @default(0) @map("acknowledgement_percent")
  surveyCount            Int       @default(0) @map("survey_count")
  totalResponses         Int       @default(0) @map("total_responses")
  responsePercent        Int       @default(0) @map("response_percent")
  refreshedAt            String    @map("refreshed_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at")

  @@unique([tenantId, audienceId])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("engagement_profile")
}

// ---------------------------------------------------------------------------------
// P2-D23 — Admissions, Marketing, Enrollment & Growth Platform
// ---------------------------------------------------------------------------------

/// MarketingCampaign (P2-D23) — a drive to attract prospective families through a channel over an optional
/// period (code unique per tenant); draft -> active -> completed | cancelled. Marketing message delivery is
/// the notifications (P1-M05) / engagement (P2-D22) concern; leads may be attributed to a campaign. No money.
/// Tenant-owned: FORCE RLS.
model MarketingCampaign {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  channel        String
  startOn        String?   @map("start_on")
  endOn          String?   @map("end_on")
  status         String    @default("draft")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("marketing_campaign")
}

/// Lead (P2-D23) — an inbound inquiry from a prospective family, the top of the funnel (code unique per
/// tenant); a contact name + optional phone/email held here (never on an event), an acquisition source and an
/// optional attributed campaign; new -> contacted -> qualified -> converted, lost from any open state.
/// Tenant-owned: FORCE RLS.
model Lead {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  contactName    String    @map("contact_name")
  phone          String?
  email          String?
  source         String
  campaignId     String?   @map("campaign_id") @db.Uuid
  status         String    @default("new")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, campaignId])
  @@map("lead")
}

/// AdmissionCycle (P2-D23) — an intake season with a per-grade seat plan (JSONB) and an application window
/// (code unique per tenant); planning -> open -> closed -> archived. The seat plan feeds the intake engine
/// against confirmed enrolments. Tenant-owned: FORCE RLS.
model AdmissionCycle {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  code            String
  name            String
  academicYear    String    @map("academic_year")
  gradeCapacities Json      @default("[]") @map("grade_capacities")
  opensOn         String?   @map("opens_on")
  closesOn        String?   @map("closes_on")
  status          String    @default("planning")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("admission_cycle")
}

/// Application (P2-D23) — the admissions record for one applicant (a Person, P2-D01-M02) in one cycle for a
/// grade (code unique per tenant), optionally from a lead; submitted -> under_review -> interview -> offered,
/// with waitlisted | rejected | withdrawn branches. The prospect/student record is Student Lifecycle's
/// (P2-D03), referenced by id. Tenant-owned: FORCE RLS.
model Application {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  cycleId           String    @map("cycle_id") @db.Uuid
  applicantPersonId String    @map("applicant_person_id") @db.Uuid
  leadId            String?   @map("lead_id") @db.Uuid
  code              String
  gradeApplyingFor  String    @map("grade_applying_for")
  status            String    @default("submitted")
  submittedOn       String    @map("submitted_on")
  decidedOn         String?   @map("decided_on")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, cycleId])
  @@index([tenantId, organizationId])
  @@map("application")
}

/// AdmissionEvaluation (P2-D23) — an immutable, append-only entrance evaluation for an application (type, a
/// 0-100 score, a recommendation). No lifecycle. An admissions screening, distinct from an academic assessment
/// (P2-D10). Tenant-owned: FORCE RLS.
model AdmissionEvaluation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  applicationId  String    @map("application_id") @db.Uuid
  type           String
  score          Int
  recommendation String
  evaluatedOn    String    @map("evaluated_on")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, applicationId])
  @@map("admission_evaluation")
}

/// Offer (P2-D23) — a seat offer for an application that reached `offered`, for a grade, with an optional
/// response deadline (one offer per application, DB-backed); extended -> accepted | declined | expired |
/// withdrawn. Accepting bridges to an enrollment confirmation. Tenant-owned: FORCE RLS.
model Offer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  applicationId  String    @map("application_id") @db.Uuid
  cycleId        String    @map("cycle_id") @db.Uuid
  gradeOffered   String    @map("grade_offered")
  extendedOn     String    @map("extended_on")
  respondBy      String?   @map("respond_by")
  status         String    @default("extended")
  respondedOn    String?   @map("responded_on")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, applicationId])
  @@index([tenantId])
  @@index([tenantId, cycleId])
  @@map("offer")
}

/// EnrollmentConfirmation (P2-D23) — the immutable close of the funnel: an accepted offer turned into a
/// confirmed seat (one per offer, DB-backed). The hand-off to Student Lifecycle (P2-D03) is the
/// admissions.enrollment.confirmed event; `student_id` records the resulting student reference once known.
/// No lifecycle. Tenant-owned: FORCE RLS.
model EnrollmentConfirmation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  offerId           String    @map("offer_id") @db.Uuid
  applicationId     String    @map("application_id") @db.Uuid
  cycleId           String    @map("cycle_id") @db.Uuid
  applicantPersonId String    @map("applicant_person_id") @db.Uuid
  gradeConfirmed    String    @map("grade_confirmed")
  studentId         String?   @map("student_id") @db.Uuid
  confirmedOn       String    @map("confirmed_on")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  @@unique([tenantId, offerId])
  @@index([tenantId])
  @@index([tenantId, cycleId])
  @@map("enrollment_confirmation")
}

/// AdmissionsFunnelProfile (P2-D23) — a descriptive, re-derivable per-cycle read model snapshotting the two
/// pure engines (funnel stage counts + conversion rates; cycle-wide intake fill). One per cycle. Tenant-owned:
/// FORCE RLS.
model AdmissionsFunnelProfile {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                  String    @map("tenant_id") @db.Uuid
  organizationId            String    @map("organization_id") @db.Uuid
  cycleId                   String    @map("cycle_id") @db.Uuid
  leadCount                 Int       @default(0) @map("lead_count")
  applicationCount          Int       @default(0) @map("application_count")
  offerCount                Int       @default(0) @map("offer_count")
  enrollmentCount           Int       @default(0) @map("enrollment_count")
  leadToApplicationPercent  Int       @default(0) @map("lead_to_application_percent")
  applicationToOfferPercent Int       @default(0) @map("application_to_offer_percent")
  offerToEnrollmentPercent  Int       @default(0) @map("offer_to_enrollment_percent")
  overallConversionPercent  Int       @default(0) @map("overall_conversion_percent")
  gradeCount                Int       @default(0) @map("grade_count")
  totalCapacity             Int       @default(0) @map("total_capacity")
  totalConfirmed            Int       @default(0) @map("total_confirmed")
  fillPercent               Int       @default(0) @map("fill_percent")
  refreshedAt               String    @map("refreshed_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  createdBy                 String?   @map("created_by") @db.Uuid
  updatedBy                 String?   @map("updated_by") @db.Uuid
  deletedAt                 DateTime? @map("deleted_at")

  @@unique([tenantId, cycleId])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("admissions_funnel_profile")
}

// ---------------------------------------------------------------------------------
// P2-D24 — Alumni, Community & Relationship Platform
// ---------------------------------------------------------------------------------

/// AlumniProfile (P2-D24) — an alumnus's membership in the alumni network, built on the alumnus lifecycle stage
/// that Student Lifecycle (P2-D03) owns; references the alumnus as a Person (P2-D01-M02); active <-> lapsed ->
/// opted_out. One profile per person per tenant. Tenant-owned: FORCE RLS.
model AlumniProfile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  alumnusPersonId String    @map("alumnus_person_id") @db.Uuid
  graduationYear  String    @map("graduation_year")
  program         String?
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at")

  @@unique([tenantId, alumnusPersonId])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("alumni_profile")
}

/// AlumniChapter (P2-D24) — a regional/interest/class-year/professional alumni community (code unique per
/// tenant); forming -> active <-> inactive -> archived. Tenant-owned: FORCE RLS.
model AlumniChapter {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  code           String
  name           String
  type           String
  region         String?
  status         String    @default("forming")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("alumni_chapter")
}

/// ChapterMembership (P2-D24) — an alumni profile's membership in a chapter with a role; active -> left with
/// left -> active reactivation. One row per (chapter, alumni profile) — DB-backed, absolute (not
/// status-scoped). Tenant-owned: FORCE RLS.
model ChapterMembership {
