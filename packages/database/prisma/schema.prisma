}

/// Counselling case (P2-D05) — case registration, append-only confidential session
/// history, referrals, goals and closure. A learner may have many cases over time.
/// Isolated behind the enhanced-privacy counselling:* scope. Tenant-owned: FORCE RLS.
model CounsellingCase {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
