}

/// Counselling case (P2-D05) — case registration, append-only confidential session
/// history, referrals, goals and closure. A learner may have many cases over time.
/// Isolated behind the enhanced-privacy counselling:* scope. Tenant-owned: FORCE RLS.
model CounsellingCase {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  counsellorId      String    @map("counsellor_id") @db.Uuid
  presentingConcern String    @map("presenting_concern")
  priority          String    @default("normal")
  status            String    @default("open")
  sessions          Json      @default("[]")
  referrals         Json      @default("[]")
  goals             Json      @default("[]")
  outcome           String?
  openedAt          DateTime  @map("opened_at")
  closedAt          DateTime? @map("closed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, counsellorId])
  @@index([tenantId, organizationId])
  @@map("counselling_case")
}

/// Safeguarding case (P2-D05) — child-protection concern, incident reports, risk
