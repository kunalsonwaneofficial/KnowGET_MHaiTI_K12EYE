  executionRequestedAt String?  @map("execution_requested_at")
  executionError       String?  @map("execution_error")
  compensationState    String   @default("not_required") @map("compensation_state")
  compensationRef      String?  @map("compensation_ref")
  compensatedAt        String?  @map("compensated_at")
  firedAt              String   @map("fired_at")
  settledAt            String?  @map("settled_at")
