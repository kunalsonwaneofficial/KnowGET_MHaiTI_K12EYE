  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  @@unique([tenantId, key, version])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, key])
  @@index([tenantId, status])
  @@index([tenantId, triggerSignalKey])
  @@map("workflow_definition")
}

/// WorkflowInstance (P2-D27) — one case running (or settled) under one workflow version. The key and version
/// are snapshotted so a case can name its process after that version is retired. `stage_runs` holds the
/// per-stage record — who it fell to, when it began and settled, the runtime reference it requested — inside
/// the aggregate. Never deleted: what an institution did about one subject, stage by stage, is the whole reason
/// for modelling a process rather than just doing it. Tenant-owned: FORCE RLS.
model WorkflowInstance {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
