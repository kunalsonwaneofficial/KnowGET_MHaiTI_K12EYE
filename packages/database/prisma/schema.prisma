/// ClassroomSession (P2-D09) — the delivery of a scheduled session capturing planned vs actual
/// (scheduled → delivered → completed | cancelled). Tenant-owned: FORCE RLS.
model ClassroomSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  scheduleSlotId      String?   @map("schedule_slot_id") @db.Uuid
  lessonPlanId        String?   @map("lesson_plan_id") @db.Uuid
  sectionId           String?   @map("section_id") @db.Uuid
  subjectId           String?   @map("subject_id") @db.Uuid
  title               String
  date                String
  plannedTopics       Json      @default("[]") @map("planned_topics")
  actualTopicsCovered Json      @default("[]") @map("actual_topics_covered")
  activitiesCompleted Json      @default("[]") @map("activities_completed")
  resourcesUsedIds    Json      @default("[]") @map("resources_used_ids")
  participation       Json?
  teacherReflections  String?   @map("teacher_reflections")
  status              String    @default("scheduled")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, sectionId])
  @@index([tenantId, subjectId])
  @@map("classroom_session")
}

/// Assignment (P2-D09) — scheduled work with a submission window and per-learner completion
/// tracking (draft → published → closed); evaluation is the Assessment platform's. Tenant-owned: FORCE RLS.
model Assignment {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
