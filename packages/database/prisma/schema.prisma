  organizationId         String    @map("organization_id") @db.Uuid
  studentId              String    @map("student_id") @db.Uuid
  status                 String    @default("active")
  academicAccommodations String[]  @map("academic_accommodations")
  medicalAccommodations  String[]  @map("medical_accommodations")
  behaviourInterventions String[]  @map("behaviour_interventions")
  inclusionStrategies    String[]  @map("inclusion_strategies")
  goals                  Json      @default("[]")
  reviewSchedule         Json      @default("{}") @map("review_schedule")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at")

  @@unique([tenantId, studentId])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("learner_support_plan")
}

/// Intervention plan (P2-D05) — early-warning triggers and the set of assigned
