  stepId                    String?  @map("step_id") @db.Uuid
  capabilityKey             String   @map("capability_key")
  ordinal                   Int      @default(1)
  riskLevel                 String   @map("risk_level")
  reversibility             String
  compensationKey           String?  @map("compensation_key")
  status                    String   @default("authorized")
  authorizationOutcome      String   @map("authorization_outcome")
  authorizationReasons      String[] @map("authorization_reasons")
  approvalRequestId         String?  @map("approval_request_id") @db.Uuid
  compensatedByInvocationId String?  @map("compensated_by_invocation_id") @db.Uuid
  failureCode               String?  @map("failure_code")
  startedAt                 String?  @map("started_at")
  settledAt                 String?  @map("settled_at")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  createdBy                 String?  @map("created_by") @db.Uuid
  updatedBy                 String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, agentId])
  @@index([tenantId, planId])
  @@index([tenantId, capabilityKey])
  @@map("tool_invocation")
}

/// ReasoningSession (P2-D26) — the record of why an agent proposed what it proposed. `traces` holds the
/// ordered reasoning steps (retrieval, observation, inference, decision) with their knowledge-graph refs and
/// what each rests on; retrieved knowledge only ever originates from the D25 graph. Free text lives here and
