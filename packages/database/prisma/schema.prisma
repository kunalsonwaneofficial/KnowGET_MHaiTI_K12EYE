// KnowGET MHaiTI — Enterprise Data Platform (P1-M03) + Phase-2 domain tables.
// Prisma is an infrastructure implementation detail; domains depend on the
// @knowget/persistence abstractions, never on this client directly.
// Platform tables (P1) and per-domain tables (P2+) live here; every
// tenant-owned table enables FORCE Row-Level Security (see the RLS migrations).

generator client {
  provider      = "prisma-client-js"
  // "native" for local/CI; the musl target lets the client run on Alpine-based
  // container images (P1-M06 / resolves TD-15).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Platform audit trail (platform auditing — not business audit reporting).
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  actorId       String?  @map("actor_id") @db.Uuid
  correlationId String?  @map("correlation_id")
  data          Json?
  occurredAt    DateTime @default(now()) @map("occurred_at")

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("audit_log")
}

/// Platform data-platform verification fixture — exercises the reusable
/// repository, transactions, soft delete and tenant (RLS) isolation. It is NOT
/// a business entity; it is the concrete surface the data platform is tested on.
model DataProbe {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String
  value         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  correlationId String?   @map("correlation_id")
  deletedAt     DateTime? @map("deleted_at")

  @@index([tenantId])
  @@map("data_probe")
}

/// Organization domain (P2-D01-M01) — a node in the institution's hierarchy
/// (trust/society → school → campus → department → grade → section). Structure
/// only; membership and people arrive in later Identity & Organization contracts.
/// Tenant-owned: FORCE RLS isolates every row (see the add_organization migration).
model Organization {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  type      String
  name      String
  code      String
  status    String    @default("draft")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, parentId])
  @@map("organization")
}

/// Person domain (P2-D01-M02) — the persona-agnostic canonical human record.
/// Contacts are an embedded value-object collection (JSONB); `match_key` is a
/// deterministic dedup key (family|given|dob). Tenant-owned: FORCE RLS isolates
/// every row (see the add_person migration).
model Person {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  givenName     String    @map("given_name")
  familyName    String    @map("family_name")
  middleName    String?   @map("middle_name")
  preferredName String?   @map("preferred_name")
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        String    @default("unspecified")
  status        String    @default("active")
  contacts      Json      @default("[]")
  matchKey      String    @map("match_key")
  mergedInto    String?   @map("merged_into") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, matchKey])
  @@map("person")
}

/// Enterprise Identity domain (P2-D01-M03) — a tenant-scoped login account that
/// links a Person (`person_id`) to the identifiers and credential they
/// authenticate with, plus status and failed-login lockout counters. Identifiers
/// are an embedded JSONB value-object collection; `identifier_keys` is a
/// normalized, GIN-indexed lookup array powering tenant-scoped identifier
/// resolution. Tenant-owned: FORCE RLS isolates every row (see the
/// add_identity_account migration).
model IdentityAccount {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  personId            String    @map("person_id") @db.Uuid
  identifiers         Json      @default("[]")
  identifierKeys      String[]  @map("identifier_keys")
  credentialHash      String?   @map("credential_hash")
  status              String    @default("pending")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, personId])
  // The normalized identifier lookup is served by a GIN index on
  // `identifier_keys`, created in the add_identity_account migration (like RLS,
  // it is a migration-only DB feature not expressible in the Prisma schema).
  @@map("identity_account")
}

/// Membership domain (P2-D01-M04) — a person's affiliation with an organization
/// node, carrying the role names they play there, a status and an effective
/// period. The join across Person and Organization; role names are opaque (their
/// permissions are resolved by the authorization engine). Tenant-owned: FORCE RLS
/// isolates every row (see the add_membership migration).
model Membership {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  personId       String    @map("person_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  roles          String[]
  status         String    @default("active")
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, personId])
  @@index([tenantId, organizationId])
  @@map("membership")
}

/// Role catalogue domain (P2-D01-M05) — a tenant-scoped RBAC role: a named grant
/// of permissions that memberships reference by name and the authorization engine
/// expands a principal's roles into. `is_system` marks built-in roles protected
/// from deletion. Tenant-owned: FORCE RLS isolates every row (see the add_role
/// migration).
model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  description String?
  permissions String[]
  status      String    @default("active")
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, name])
  @@map("role")
}

/// Relationship domain (P2-D01-M06) — a typed association between two people, a
/// directed edge from_person → to_person (e.g. guardian→dependent, sibling↔
/// sibling). Completes the Identity & Organization people graph. Tenant-owned:
/// FORCE RLS isolates every row (see the add_relationship migration).
model Relationship {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  fromPersonId String    @map("from_person_id") @db.Uuid
  toPersonId   String    @map("to_person_id") @db.Uuid
  kind         String
  status       String    @default("active")
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, fromPersonId])
  @@index([tenantId, toPersonId])
  @@map("relationship")
}

/// Security session persistence (P2-D01 security hardening — TD-16). The
/// server-side record of an authenticated session; the access token's `sid` claim
/// references it, so revoking a row (revoked=true) or letting it lapse makes the
/// guard reject that session's tokens on the next request. `id` is the opaque
/// session token (not a UUID); the timestamps are epoch-milliseconds (the frozen
/// `Session` contract, P1-M04). Tenant-owned: FORCE RLS isolates every row (see
/// the add_security_session_revocation migration).
model SecuritySession {
  id             String  @id
  tenantId       String  @map("tenant_id") @db.Uuid
  identityId     String  @map("identity_id") @db.Uuid
  createdAt      BigInt  @map("created_at")
  lastActivityAt BigInt  @map("last_activity_at")
  expiresAt      BigInt  @map("expires_at")
  device         String?
  revoked        Boolean @default(false)

  @@index([tenantId])
  @@index([tenantId, identityId])
  @@map("security_session")
}

/// Token / family revocation persistence (P2-D01 security hardening — TD-16). The
/// durable backing for the token revocation registry: a revoked access-token id
/// (`jti`, kind='token') or refresh-token family (kind='family'). The guard
/// rejects a presented token whose id or family is listed. Tenant-owned: FORCE
/// RLS isolates every row (see the add_security_session_revocation migration).
model SecurityRevocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  kind      String
  ref       String
  revokedAt DateTime @default(now()) @map("revoked_at")

  @@unique([tenantId, kind, ref])
  @@index([tenantId])
  @@map("security_revocation")
}

/// Refresh-token rotation & replay detection (TD-18). A stored, tenant-scoped
/// refresh token in a rotating **family** bound to a login **session**: rotating
/// consumes a token (`status` → `rotated`) and issues its successor in the same
/// family; presenting a consumed token is a replay, which revokes the family (and
/// its session) via `security_revocation`. `token_hash` is the SHA-256 of the
/// opaque token — the raw token is never stored; timestamps are epoch-ms. Tenant-
/// owned: FORCE RLS isolates every row (see the add_security_refresh_token migration).
model SecurityRefreshToken {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  familyId   String @map("family_id")
  identityId String @map("identity_id") @db.Uuid
  sessionId  String @map("session_id")
  tokenHash  String @map("token_hash")
  status     String @default("active")
  issuedAt   BigInt @map("issued_at")
  expiresAt  BigInt @map("expires_at")

  @@unique([tenantId, tokenHash])
  @@index([tenantId, familyId])
  @@map("security_refresh_token")
}

/// Distributed blob storage (TD-19). A shared, replica-agnostic object store behind
/// the async `BlobStore` port — bytes in a `bytea` column, keyed globally (the port
/// is tenant-agnostic; callers namespace keys). `checksum` is the SHA-256 hex for
/// integrity/dedup. Selected by `SERVICES_STORE=persisted`. Not tenant-owned (no RLS).
model ServiceBlob {
  key         String   @id
  contentType String   @map("content_type")
  checksum    String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("service_blob")
}

/// Distributed full-text search (TD-19). A shared document index behind the async
/// search port. `text` is the searchable content; `fields` holds filterable exact-
/// match attributes (JSONB). A generated `tsv` tsvector column + GIN index (created
/// in the add_service_search migration, not expressible in Prisma) power ranking.
/// Global (tenant is a field, not RLS). Selected by `SERVICES_STORE=persisted`.
model ServiceSearchDocument {
  id     String @id
  text   String
  fields Json   @default("{}")

  @@map("service_search_document")
}

/// Governance body (P2-D02). The authoritative unit of governance for an
/// organization node (board of trustees, councils, management/finance/academic
/// committees), nesting via `parentBodyId`. Tenant-owned; isolated by FORCE RLS.
model GovernanceBody {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  parentBodyId     String?   @map("parent_body_id") @db.Uuid
  name             String
  type             String
  status           String    @default("active")
  termsOfReference String?   @map("terms_of_reference")
  establishedOn    DateTime? @map("established_on") @db.Date
  dissolvedOn      DateTime? @map("dissolved_on") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, parentBodyId])
  @@map("governance_body")
}

/// Committee (P2-D02). An operational committee with an embedded composition
/// (`members`: chair/secretary/member Persons), optionally reporting to a body.
model GovernanceCommittee {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  governanceBodyId String?   @map("governance_body_id") @db.Uuid
  name             String
  purpose          String?
  termsOfReference String?   @map("terms_of_reference")
  members          Json      @default("[]")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("governance_committee")
}

/// Policy (P2-D02). A version-controlled institutional policy in the central
/// registry, scoped to an organization node and lifecycle-managed.
model GovernancePolicy {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  category       String
  title          String
  body           String    @default("")
  version        Int       @default(1)
  status         String    @default("draft")
  ownerId        String    @map("owner_id") @db.Uuid
  effectiveOn    DateTime? @map("effective_on") @db.Date
  approvedOn     DateTime? @map("approved_on") @db.Date
  publishedOn    DateTime? @map("published_on") @db.Date
  retiredOn      DateTime? @map("retired_on") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@map("governance_policy")
}

/// Policy acknowledgment (P2-D02). A Person's acknowledgment of a published policy
/// version. Tenant-owned; one per (policy, person, version). An immutable,
/// append-only compliance ledger — intentionally exempt from the audit/soft-delete
/// columns the other governance tables carry (records are never edited or removed).
model GovernancePolicyAcknowledgment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  policyId       String   @map("policy_id") @db.Uuid
  personId       String   @map("person_id") @db.Uuid
  version        Int
  acknowledgedOn DateTime @map("acknowledged_on")

  @@unique([tenantId, policyId, personId, version])
  @@index([tenantId, policyId])
  @@map("governance_policy_acknowledgment")
}

/// Delegation of authority (P2-D02). A delegated approval power (scope + optional
/// monetary limit) from a delegator to a delegate, over an effective window.
model GovernanceDelegation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  delegatorId    String    @map("delegator_id") @db.Uuid
  delegateId     String    @map("delegate_id") @db.Uuid
  scope          String
  description    String?
  monetaryLimit  BigInt?   @map("monetary_limit")
  status         String    @default("active")
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  grantedOn      DateTime  @map("granted_on") @db.Date
  revokedOn      DateTime? @map("revoked_on") @db.Date
  revokedReason  String?   @map("revoked_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, delegateId])
  @@map("governance_delegation")
}

/// Resolution (P2-D02). A formal decision of a governance body, with an embedded
/// `votes` collection, tallied to approval/rejection and tracked to implementation.
model GovernanceResolution {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  governanceBodyId String    @map("governance_body_id") @db.Uuid
  title            String
  proposalText     String    @map("proposal_text")
  proposedById     String    @map("proposed_by_id") @db.Uuid
  status           String    @default("draft")
  votes            Json      @default("[]")
  effectiveOn      DateTime? @map("effective_on") @db.Date
  approvedOn       DateTime? @map("approved_on") @db.Date
  implementedOn    DateTime? @map("implemented_on") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, governanceBodyId])
  @@map("governance_resolution")
}

/// Governance calendar entry (P2-D02). A meeting, compliance deadline, board
/// activity, regulatory event or review; meetings carry minutes and `attendeeIds`.
model GovernanceCalendarEntry {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  governanceBodyId String?   @map("governance_body_id") @db.Uuid
  committeeId      String?   @map("committee_id") @db.Uuid
  type             String
  title            String
  description      String?
  scheduledOn      DateTime  @map("scheduled_on") @db.Date
  status           String    @default("scheduled")
  completedOn      DateTime? @map("completed_on") @db.Date
  minutes          String?
  attendeeIds      Json      @default("[]") @map("attendee_ids")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, scheduledOn])
  @@map("governance_calendar_entry")
}

/// Governance approval (P2-D02). A persisted instance of the single reusable
/// approval workflow (policy/committee/resolution/delegation approval), driven by
/// the Phase-1 workflow engine. `history` is the append-only decision audit trail.
model GovernanceApproval {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  kind           String
  subjectId      String    @map("subject_id") @db.Uuid
  state          String    @default("draft")
  status         String    @default("running")
  submittedById  String    @map("submitted_by_id") @db.Uuid
  decidedById    String?   @map("decided_by_id") @db.Uuid
  note           String?
  history        Json      @default("[]")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, kind, subjectId])
  @@map("governance_approval")
}

/// Prospect (P2-D03) — a prospective learner in the enquiry funnel, linked to a
/// Person. Lead metadata (source, campaign, interests) + follow-up history only;
/// never duplicates identity. Tenant-owned: FORCE RLS (see the add_student_lifecycle
/// migration).
model StudentProspect {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  personId       String    @map("person_id") @db.Uuid
  leadSource     String    @map("lead_source")
  campaign       String?
  interests      String[]
  status         String    @default("new")
  followUps      Json      @default("[]") @map("follow_ups")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("student_prospect")
}

/// Applicant (P2-D03) — a formal admissions application, linked to a Person and
/// optionally converted from a Prospect. Carries the document checklist, interview
/// and admission decision. Tenant-owned: FORCE RLS.
model StudentApplicant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  personId       String    @map("person_id") @db.Uuid
  prospectId     String?   @map("prospect_id") @db.Uuid
  programId      String?   @map("program_id") @db.Uuid
  status         String    @default("draft")
  documents      Json      @default("[]")
  interview      Json?
  decision       Json?
  submittedOn    DateTime? @map("submitted_on") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, personId])
  @@map("student_applicant")
}

/// Student (P2-D03) — the enrolled learner. Identity is a Person and the
/// institutional affiliation a Membership; the record links to both and never
/// duplicates them. Carries enrollment/academic/administrative status and the
/// program / campus / section / academic-year assignment. Tenant-owned: FORCE RLS.
model Student {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String    @map("tenant_id") @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  personId             String    @map("person_id") @db.Uuid
  membershipId         String?   @map("membership_id") @db.Uuid
  applicantId          String?   @map("applicant_id") @db.Uuid
  studentNumber        String    @map("student_number")
  programId            String?   @map("program_id") @db.Uuid
  sectionId            String?   @map("section_id") @db.Uuid
  academicYear         String?   @map("academic_year")
  rollNumber           String?   @map("roll_number")
  enrollmentStatus     String    @default("enrolled") @map("enrollment_status")
  academicStatus       String    @default("good_standing") @map("academic_status")
  administrativeStatus String    @default("clear") @map("administrative_status")
  enrolledOn           DateTime? @map("enrolled_on") @db.Date
  exitedOn             DateTime? @map("exited_on") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  createdBy            String?   @map("created_by") @db.Uuid
  updatedBy            String?   @map("updated_by") @db.Uuid
  deletedAt            DateTime? @map("deleted_at")

  @@unique([tenantId, studentNumber])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, personId])
  @@map("student")
}

/// Educational journey (P2-D03) — a student's append-only academic-progression
/// record (promotions, retentions, transfers, withdrawals, graduation). One per
/// student. Tenant-owned: FORCE RLS.
model StudentEducationalJourney {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  entries        Json      @default("[]")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, studentId])
  @@index([tenantId])
  @@map("student_educational_journey")
}

/// Intelligence profile (P2-D03) — a student's AI-ready indicators and intervention
/// history. Model + integration points only (prediction lives in the Institutional
/// Intelligence program). One per student. Tenant-owned: FORCE RLS.
model StudentIntelligenceProfile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  indicators     Json      @default("{}")
  interventions  Json      @default("[]")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, studentId])
  @@index([tenantId])
  @@map("student_intelligence_profile")
}

/// Student timeline entry (P2-D03) — an immutable, append-only institutional event
/// on a learner's permanent history (admissions, class changes, promotions, awards,
/// incidents, interventions, graduations). No update or delete; no history is lost.
/// Tenant-owned: FORCE RLS.
model StudentTimelineEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  type           String
  occurredOn     DateTime @map("occurred_on") @db.Date
  summary        String
  detail         String?
  sourceEvent    String?  @map("source_event")
  recordedAt     DateTime @default(now()) @map("recorded_at")

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, organizationId])
  @@index([tenantId, occurredOn])
  @@map("student_timeline_entry")
}

/// Family (P2-D04) — a household unit, a dynamic institutional stakeholder rather than
/// an attribute of a student. Members are Persons; the family carries addresses, a
/// primary contact, communication defaults and a merge/split/archive lifecycle.
/// Independent of Student. Tenant-owned: FORCE RLS (see the add_family_guardian migration).
model Family {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  familyNumber           String    @map("family_number")
  name                   String
  members                Json      @default("[]")
  primaryContactPersonId String?   @map("primary_contact_person_id") @db.Uuid
  addresses              Json      @default("[]")
  preferredLanguage      String?   @map("preferred_language")
  preferredChannel       String?   @map("preferred_channel")
  status                 String    @default("active")
  mergedIntoFamilyId     String?   @map("merged_into_family_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at")

  @@unique([tenantId, familyNumber])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("family")
}

/// Guardian (P2-D04) — a legal or designated guardian, linked to a Person and never
/// duplicating identity. Carries legal authority, an independent verification standing,
/// contacts, availability and the pending/active/suspended/archived lifecycle. One per
/// person per organization. Tenant-owned: FORCE RLS.
model Guardian {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  personId         String    @map("person_id") @db.Uuid
  legalAuthority   String    @default("none") @map("legal_authority")
  verification     String    @default("unverified")
  verifiedOn       DateTime? @map("verified_on") @db.Date
  contacts         Json      @default("[]")
  availabilityNote String?   @map("availability_note")
  status           String    @default("pending")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  @@unique([tenantId, personId, organizationId])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, personId])
  @@map("guardian")
}

/// Student–Guardian relationship (P2-D04) — the many-to-many link between a P2-D03
/// Student and a Guardian: relationship type, independently-managed legal / educational
/// / financial responsibilities and pickup / medical authorizations, emergency priority
/// and effective period. Tenant-owned: FORCE RLS.
model StudentGuardianRelationship {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  guardianId        String    @map("guardian_id") @db.Uuid
  relationshipType  String    @map("relationship_type")
  responsibilities  Json      @default("{}")
  emergencyPriority Int?      @map("emergency_priority")
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, guardianId])
  @@map("student_guardian_relationship")
}

/// Family consent (P2-D04) — an immutable, append-only institutional consent record.
/// Every grant or withdrawal is a new versioned, timestamped row per (student,
/// consentType); no row is ever edited or deleted. Optionally linked to a governance
/// policy (P2-D02). Tenant-owned: FORCE RLS.
model FamilyConsent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  guardianId     String    @map("guardian_id") @db.Uuid
  consentType    String    @map("consent_type")
  decision       String
  version        Int
  policyId       String?   @map("policy_id") @db.Uuid
  note           String?
  effectiveOn    DateTime  @map("effective_on") @db.Date
  expiresOn      DateTime? @map("expires_on") @db.Date
  recordedAt     DateTime  @default(now()) @map("recorded_at")
  createdBy      String?   @map("created_by") @db.Uuid

  @@unique([tenantId, studentId, consentType, version])
  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, organizationId])
  @@map("family_consent")
}

