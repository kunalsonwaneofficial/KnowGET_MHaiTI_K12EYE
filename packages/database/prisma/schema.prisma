// ============================================================================
// P2-D28 — Predictive Intelligence, Simulation & Strategic Planning
// The forward-looking layer of the intelligence core (Program E), and where
// prediction deferred out of all twenty-four operational domains lands. One
// rule is structural here rather than procedural: every forecast carries its
// confidence intervals, its declared assumptions, its uncertainty grade and
// the digest of the inputs it was computed from, so a run made today can be
// re-verified against the institution's records years from now.
// A series is the measured history; a run, a backtest, a simulation and a
// plan are what was projected, scored, explored and committed to. None of
// them has a delete path. Only a draft model and a draft scenario can be
// taken away.
// All tenant-isolated by FORCE RLS.
// ============================================================================

/// ObservationSeries (P2-D28) — the measured history of one metric about one subject, and the only thing this
/// domain forecasts from. `observations` holds the readings inside the aggregate, sorted by period, because
/// `version` identifies that whole set and a reading written on its own would move the history a run pinned
/// without moving the number that says it moved. `source_domain` and `subject_ref` name a record in another
/// domain and never re-model it. `cycle_length` is declared, never inferred from the grain — a guessed season
/// produces a specifically wrong forecast. Never deleted: withdrawing a reading and closing a series exist so
/// that correcting the history stays visible. Tenant-owned: FORCE RLS.
model ObservationSeries {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  seriesKey      String   @map("series_key")
  metricKey      String   @map("metric_key")
  sourceDomain   String   @map("source_domain")
  subjectRef     String?  @map("subject_ref")
  grain          String
  direction      String
  cycleLength    Int?     @map("cycle_length")
  unit           String?
  observations   Json     @default("[]")
  version        Int      @default(1)
  status         String   @default("active")
  closedAt       String?  @map("closed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, organizationId, seriesKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, metricKey])
  @@index([tenantId, status])
  @@index([tenantId, sourceDomain, subjectRef])
  @@map("observation_series")
}

/// ForecastModel (P2-D28) — one version of a named projection method and the parameters it reads. A key does
/// not identify a model; a key and a version do, because a published model is frozen and revising it opens a
/// new draft beside the one runs are pinning — hence the unique on (tenant, key, version) and no unique on key
/// alone. `version` is 0 while a model is a draft and is minted on publication, which is also when the row
/// becomes immutable in practice. Only one version of a key is published at a time. Draft versions are
/// discardable; a published one is retired. Tenant-owned: FORCE RLS.
model ForecastModel {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  modelKey         String    @map("model_key")
  name             String
  description      String?
  method           String
  parameters       Json      @default("{}")
  confidenceLevels Int[]     @map("confidence_levels")
  version          Int       @default(0)
  status           String    @default("draft")
  publishedAt      String?   @map("published_at")
  retiredAt        String?   @map("retired_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at")

  @@unique([tenantId, modelKey, version])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, modelKey])
  @@index([tenantId, status])
  @@map("forecast_model")
}

/// ForecastRun (P2-D28) — one forecast, and everything needed to make the same one again. The pinned inputs
/// (series key and version, model key and version, method, resolved parameters, horizon, confidence levels,
/// assumptions) are stored as their own columns and JSONB rather than as references, because a reference
/// resolves to today's answer and reproducibility is a claim about the day the run was made. `digest` is the
/// hash of exactly those inputs and `canonical` the string it was taken over, kept beside it so a disagreement
/// is a diff rather than a mystery. `digest` is indexed but not unique: a superseded run and the fresh one
/// answering the same question share it. Never deleted — superseded and invalidated are the ways out, and both
/// leave the record of what was projected intact. Tenant-owned: FORCE RLS.
model ForecastRun {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  seriesId          String   @map("series_id") @db.Uuid
  seriesKey         String   @map("series_key")
  seriesVersion     Int      @map("series_version")
  modelId           String   @map("model_id") @db.Uuid
  modelKey          String   @map("model_key")
  modelVersion      Int      @map("model_version")
  method            String
  parameters        Json     @default("{}")
  horizon           Int
  confidenceLevels  Int[]    @map("confidence_levels")
  assumptions       Json     @default("[]")
  points            Json     @default("[]")
  uncertainty       Json
  fallbackPeriods   Int[]    @map("fallback_periods")
  digest            String
  canonical         String
  status            String   @default("completed")
  producedByUserId  String?  @map("produced_by_user_id") @db.Uuid
  producedAt        String   @map("produced_at")
  supersededByRunId String?  @map("superseded_by_run_id") @db.Uuid
  supersededAt      String?  @map("superseded_at")
  invalidatedAt     String?  @map("invalidated_at")
  invalidationDrift String[] @map("invalidation_drift")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @map("created_by") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, digest])
  @@index([tenantId, seriesId])
  @@index([tenantId, modelId])
  @@index([tenantId, status])
  @@map("forecast_run")
}

/// Backtest (P2-D28) — a model scored against history it was not fitted on, which is what earns publication.
/// `scored` holds each projected point beside what actually happened: the atoms every score was computed from,
/// kept so a verdict can be re-derived rather than trusted. `publishable` is frozen at the moment of scoring so
/// the verdict and its evidence never diverge, and `model_version` is 0 in the ordinary case because a draft is
/// exactly what is being scored. Never edited and never deleted — a retune is scored beside the first reading,
/// not over it, so the sequence stays visible. Tenant-owned: FORCE RLS.
model Backtest {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                  String   @map("tenant_id") @db.Uuid
  organizationId            String   @map("organization_id") @db.Uuid
  seriesId                  String   @map("series_id") @db.Uuid
  seriesKey                 String   @map("series_key")
  seriesVersion             Int      @map("series_version")
  modelId                   String   @map("model_id") @db.Uuid
  modelKey                  String   @map("model_key")
  modelVersion              Int      @map("model_version")
  method                    String
  parameters                Json     @default("{}")
  holdoutSize               Int      @map("holdout_size")
  trainingCount             Int      @map("training_count")
  firstHoldoutPeriod        Int      @map("first_holdout_period")
  lastHoldoutPeriod         Int      @map("last_holdout_period")
  scored                    Json     @default("[]")
  scores                    Json
  baselineMeanAbsoluteError Float    @map("baseline_mean_absolute_error")
  publishable               Boolean  @default(false)
  ranByUserId               String?  @map("ran_by_user_id") @db.Uuid
  ranAt                     String   @map("ran_at")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  createdBy                 String?  @map("created_by") @db.Uuid
  updatedBy                 String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, seriesId])
  @@index([tenantId, modelId])
  @@index([tenantId, seriesId, modelId])
  @@map("backtest")
}

/// Scenario (P2-D28) — a named set of levers to apply to a forecast: what the institution wants to ask "what
/// if" about. `levers` lives inside the aggregate because `version` identifies the lever set as a whole and a
/// simulation pins that number; a lever written on its own would move what an outcome claimed to be a
/// departure from. Editable while a draft, frozen at publication — revising a published case opens a new draft
/// under a new key rather than editing the one simulations cite. A draft nothing was ever simulated against is
/// discardable; a published one is archived. Tenant-owned: FORCE RLS.
model Scenario {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  scenarioKey    String    @map("scenario_key")
  name           String
  description    String?
  levers         Json      @default("[]")
  version        Int       @default(1)
  status         String    @default("draft")
  publishedAt    String?   @map("published_at")
  archivedAt     String?   @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at")

  @@unique([tenantId, organizationId, scenarioKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, status])
  @@map("scenario")
}

/// SimulationRun (P2-D28) — one published scenario measured against one standing forecast. It snapshots both
/// sides (`scenario_version`, and the baseline's whole pinned identity down to `forecast_run_digest`) because
/// an outcome has to keep saying what it was a departure from after the baseline is superseded; the digest is
/// what still identifies the forecast once the run row no longer does. Reading the reverse direction — which
/// simulations a withdrawn forecast has just called into doubt — is the index on (tenant, forecast_run_id).
/// Never edited: a newer outcome supersedes the old rather than overwriting it. Tenant-owned: FORCE RLS.
model SimulationRun {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  scenarioId           String   @map("scenario_id") @db.Uuid
  scenarioKey          String   @map("scenario_key")
  scenarioVersion      Int      @map("scenario_version")
  forecastRunId        String   @map("forecast_run_id") @db.Uuid
  forecastRunDigest    String   @map("forecast_run_digest")
  seriesKey            String   @map("series_key")
  seriesVersion        Int      @map("series_version")
  modelKey             String   @map("model_key")
  modelVersion         Int      @map("model_version")
  method               String
  horizon              Int
  levers               Json     @default("[]")
  variedAssumptionKeys String[] @map("varied_assumption_keys")
  points               Json     @default("[]")
  totalBaseline        Float    @map("total_baseline")
  totalScenario        Float    @map("total_scenario")
  totalDelta           Float    @map("total_delta")
  peakDelta            Float    @map("peak_delta")
  inheritedUncertainty String   @map("inherited_uncertainty")
  overridden           Boolean  @default(false)
  unappliedLeverKeys   String[] @map("unapplied_lever_keys")
  status               String   @default("completed")
  supersededByRunId    String?  @map("superseded_by_run_id") @db.Uuid
  supersededAt         String?  @map("superseded_at")
  ranByUserId          String?  @map("ran_by_user_id") @db.Uuid
  ranAt                String   @map("ran_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdBy            String?  @map("created_by") @db.Uuid
  updatedBy            String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, scenarioId])
  @@index([tenantId, forecastRunId])
  @@index([tenantId, status])
  @@map("simulation_run")
}

/// StrategicPlan (P2-D28) — what an institution committed to, measured against what it is achieving.
/// `objectives`, `progress` and `reviews` all live inside the aggregate: `version` identifies the objective set
/// a review's frozen variance was computed against, progress is held in arrival order rather than sorted, and a
/// review keeps the variance it saw rather than one recomputed later — none of which survives children that can
/// be written on their own. `metric_keys` is a normalized, GIN-indexed projection of the objectives' metric
/// keys, and it is the read that finds every plan reviewing itself against a series that has since taken a
/// correction. Never deleted: an abandoned plan is the record that a course was tried and changed, and deleting
/// it turns that into an omission. Tenant-owned: FORCE RLS.
model StrategicPlan {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  planKey           String   @map("plan_key")
  name              String
  description       String?
  startPeriod       Int      @map("start_period")
  objectives        Json     @default("[]")
  metricKeys        String[] @map("metric_keys")
  progress          Json     @default("[]")
  reviews           Json     @default("[]")
  version           Int      @default(1)
  status            String   @default("draft")
  activatedByUserId String?  @map("activated_by_user_id") @db.Uuid
  activatedAt       String?  @map("activated_at")
  closedByUserId    String?  @map("closed_by_user_id") @db.Uuid
  closedAt          String?  @map("closed_at")
  abandonmentReason String?  @map("abandonment_reason")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @map("created_by") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, organizationId, planKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, status])
  // The objective metric-key lookup is served by a GIN index on `metric_keys`,
  // created in the add_predictive_intelligence migration (like RLS, it is a
  // migration-only DB feature not expressible in the Prisma schema).
  @@map("strategic_plan")
}

// ============================================================================
// P2-D29 — Executive Intelligence, Governance & Institutional Command
// The layer leadership actually reads (Program E). Twenty-eight contracts each
// recorded what happened inside one part of the institution; this one answers
// whether the school is alright, whether it was more alright last term, and
// which part of it to go and look at first.
// Two rules are structural here rather than procedural. Every reading carries
// the evidence it stands on, and every assessment pins the weights and pillar
// reports it was computed from together with a digest of them — so a figure
// quoted in a board paper can be re-derived years later and the recomputation
// compared rather than believed.
// Periods are integer ordinals on a grid the institution declares, never
// dates: this domain holds no clock, so staleness is subtraction and a run
// reproduces exactly. No table here has a delete path.
// All tenant-isolated by FORCE RLS.
// ============================================================================

/// KpiDefinition (P2-D29) — one thing an institution measures, and what good means for it. `kpi_key` and
/// `pillar` are immutable after declaration: a key that moved would orphan every reading filed under it and
/// every panel bound to it, and an indicator that changed pillar would restate both pillars' history in every
/// period it had already reported. `scale` is the JSONB anchor set the measurement engine interpolates through,
/// frozen from activation onward, because a rescaled indicator silently restates its own past. `source_domain`
/// names the operational contract that publishes the figure and is never re-modelled here. Never deleted: an
/// indicator the institution has stopped using is retired, so the readings behind it stay explicable.
/// Tenant-owned: FORCE RLS.
model KpiDefinition {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  kpiKey         String   @map("kpi_key")
  name           String
  description    String?
  pillar         String
  sourceDomain   String   @map("source_domain")
  scale          Json
  targetScore    Float?   @map("target_score")
  status         String   @default("draft")
  activatedAt    String?  @map("activated_at")
  retiredAt      String?  @map("retired_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, kpiKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, pillar])
  @@index([tenantId, sourceDomain])
  @@map("kpi_definition")
}

/// KpiReading (P2-D29) — one figure filed against one indicator for one period, and the records it stands on.
/// `citations` is JSONB inside the aggregate and not a child table, because a reading cannot be constructed
/// without at least one usable citation and a child row that can be written on its own is exactly how that
/// invariant stops being one. `standing` is the weakest standing among those citations, derived on the way in
/// and never declared. `measurement` holds either the scored measure or the engine's explicit refusal to score
/// it — a figure of known origin and nonsensical value is what leadership needs shown, not hidden. `period` is
/// an ordinal, never a date. Never deleted: a figure that should not have counted is withdrawn, which is also
/// what frees its period for the correction that replaces it. Tenant-owned: FORCE RLS.
model KpiReading {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  kpiDefinitionId  String   @map("kpi_definition_id") @db.Uuid
  kpiKey           String   @map("kpi_key")
  pillar           String
  period           Int
  measurement      Json
  citations        Json     @default("[]")
  standing         String
  withdrawnAt      String?  @map("withdrawn_at")
  withdrawalReason String?  @map("withdrawal_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, kpiDefinitionId])
  // One standing reading per indicator per period is enforced by a PARTIAL unique
  // index on (tenant_id, kpi_definition_id, period) WHERE withdrawn_at IS NULL,
  // created in the add_executive_intelligence migration. A withdrawn figure must
  // not block the correction that replaces it, which a total unique would — and a
  // partial unique is a migration-only DB feature, like RLS.
  @@index([tenantId, kpiDefinitionId, period])
  @@index([tenantId, organizationId, kpiDefinitionId])
  @@index([tenantId, kpiKey, period])
  @@map("kpi_reading")
}

/// HealthIndexDefinition (P2-D29) — what each of the ten pillars is worth to this institution. The ten pillars
/// are fixed at the platform and their weighting is the institution's, which is the whole line between a
/// comparable index and a bespoke one. `weights` is JSONB and frozen from publication onward; `grain` is
/// declared once and immutable, because a period is an ordinal and an index that changed from terms to quarters
/// would leave every filed assessment pointing at a different stretch of the year. `superseded_by_id` is what
/// lets a reader walk a school's reweightings forward and see that a step in the series was a change of
/// question rather than of fortune. Never deleted: a superseded composition is what a past assessment was
/// computed under. Tenant-owned: FORCE RLS.
model HealthIndexDefinition {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  indexKey       String   @map("index_key")
  name           String
  description    String?
  grain          String
  weights        Json     @default("[]")
  status         String   @default("draft")
  supersededById String?  @map("superseded_by_id") @db.Uuid
  publishedAt    String?  @map("published_at")
  supersededAt   String?  @map("superseded_at")
  retiredAt      String?  @map("retired_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  // One composition of a series is in service at a time, enforced by a PARTIAL
  // unique index on (tenant_id, index_key) WHERE status = 'published', created in
  // the add_executive_intelligence migration. Superseded and retired compositions
  // keep the key, because assessments were computed under them.
  @@index([tenantId, indexKey])
  @@index([tenantId, status])
  @@map("health_index_definition")
}

/// HealthIndexAssessment (P2-D29) — one period's composite, and the pinned inputs that make it defensible.
/// `run` holds the declared weights and the pillar reports together, detached from the definition, and
/// `fingerprint` is a digest of exactly that — the cheap way to notice inputs moved, never a tamper control.
/// This is the reason the aggregate is worth storing at all: a foreign key resolves to today's weights, and
/// reproducibility is a claim about the day the figure was computed. `value` is NULL rather than zero when
/// nothing declared could be scored, because a composite that could not be computed and one that came out at
/// zero are different events. `sufficient` and `weight_redistributed` are stored as they were decided, never
/// re-derived: coverage floors could move, and a recomputed verdict would rewrite what the institution was
/// told. Never deleted: a figure that turned out wrong is invalidated in place. Tenant-owned: FORCE RLS.
model HealthIndexAssessment {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  indexDefinitionId   String   @map("index_definition_id") @db.Uuid
  indexKey            String   @map("index_key")
  period              Int
  grain               String
  run                 Json
  fingerprint         String
  value               Float?
  band                String?
  pillarCoverage      Float    @map("pillar_coverage")
  sufficient          Boolean  @default(false)
  weightRedistributed Float    @default(0) @map("weight_redistributed")
  contributions       Json     @default("[]")
  omissions           Json     @default("[]")
  evidence            Json
  status              String   @default("provisional")
  finalizedAt         String?  @map("finalized_at")
  invalidatedAt       String?  @map("invalidated_at")
  invalidationReason  String?  @map("invalidation_reason")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, indexKey, period])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, indexDefinitionId])
  @@index([tenantId, status])
  @@index([tenantId, fingerprint])
  @@map("health_index_assessment")
}

/// Dashboard (P2-D29) — what a role opens, declared as bindings rather than pictures. `panels` is an ordered
/// JSONB array and order is the only positioning this contract has, deliberately: a coordinate would leave
/// visible holes where a viewer's withheld panels used to be, and a hole is an answer. Each panel names the
/// permission scope a reader must hold; composition removes what a viewer's scopes do not reach rather than
/// blanking it in place. `dashboard_key` is immutable — it is what a saved link and an institution's
/// default-dashboard setting both resolve through — and an archived dashboard keeps it for the same reason.
/// Tenant-owned: FORCE RLS.
model Dashboard {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dashboardKey   String   @map("dashboard_key")
  name           String
  description    String?
  panels         Json     @default("[]")
  status         String   @default("draft")
  publishedAt    String?  @map("published_at")
  archivedAt     String?  @map("archived_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, dashboardKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@map("dashboard")
}

/// ExecutiveBriefing (P2-D29) — what was actually circulated, and what it said at the time. `cited` is the
/// figure as it stood when the briefing was drafted, copied rather than referenced: it survives the assessment
/// being invalidated, which is the entire point — the record of what leadership was told must not silently
/// become the record of what is true now. `findings` are frozen in the order they were ranked in.
/// `audience_scope` is required, not optional: unlike a panel a briefing has no larger document to be quietly
/// dropped out of, so a blank audience would fail open on the most sensitive record this contract produces.
/// Never deleted: a briefing that should not have gone out is withdrawn with a reason. Tenant-owned: FORCE RLS.
model ExecutiveBriefing {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  briefingKey      String   @map("briefing_key")
  title            String
  narrative        String?
  audienceScope    String   @map("audience_scope")
  assessmentId     String   @map("assessment_id") @db.Uuid
  indexKey         String   @map("index_key")
  period           Int
  cited            Json
  findings         Json     @default("[]")
  status           String   @default("draft")
  issuedAt         String?  @map("issued_at")
  withdrawnAt      String?  @map("withdrawn_at")
  withdrawalReason String?  @map("withdrawal_reason")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, briefingKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, assessmentId])
  @@index([tenantId, organizationId, status])
  @@map("executive_briefing")
}

/// AttentionItem (P2-D29) — one finding a period's arithmetic produced, and the work of clearing it. Identity
/// is (assessment, key): the assessment is which period's arithmetic raised it and the key is the engine's
/// stable name for the finding, which together are why a sweep restates rather than duplicates and why nothing
/// is ever reopened — a later period raises its own item. `severity` moves when a finding deteriorates, which
/// is exactly why it is not part of the key. `observed` is the quantity the finding was last raised on in
/// whatever its reason measures, and is never summed across items. Never deleted: acknowledging, resolving and
/// dismissing all leave the record of what was raised and who dealt with it. Tenant-owned: FORCE RLS.
model AttentionItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  assessmentId   String   @map("assessment_id") @db.Uuid
  indexKey       String   @map("index_key")
  period         Int
  key            String
  reason         String
  severity       String
  subjectKind    String   @map("subject_kind")
  subject        String
  observed       Float?
  status         String   @default("open")
  acknowledgedAt String?  @map("acknowledged_at")
  acknowledgedBy String?  @map("acknowledged_by") @db.Uuid
  closedAt       String?  @map("closed_at")
  closedBy       String?  @map("closed_by") @db.Uuid
  closureNote    String?  @map("closure_note")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, assessmentId, key])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, indexKey, period])
  @@index([tenantId, severity])
  @@map("attention_item")
}

/// ImprovementSignal (P2-D30) — something is not working, and who says so. This is the only entry point the
/// contract has: nothing downstream may be proposed against a problem nobody filed. `priority` is derived by
/// the intake engine on every account and never set by hand, which is what stops a queue being reordered by
/// whoever shouts loudest. `corroboration` counts distinct people after repeat filings collapse into
/// `repeat_accounts`, and `unattributed` counts filings with nobody behind them — three separate columns
/// because a queue that folded them together would look quieter than it is. `accounts` is JSONB and ordered:
/// every derived count above is a function of exactly that list, so a stored count that disagrees with it is
/// visibly wrong rather than quietly authoritative. Never deleted: a signal is triaged, merged or declined,
/// and a problem the institution decided not to act on is a decision worth keeping. Tenant-owned: FORCE RLS.
model ImprovementSignal {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  signalKey          String   @map("signal_key")
  source             String
  summary            String
  status             String   @default("raised")
  priority           String   @default("routine")
  corroboration      Int      @default(0)
  repeatAccounts     Int      @default(0) @map("repeat_accounts")
  unattributed       Int      @default(0)
  selfEvident        Boolean  @default(false) @map("self_evident")
  citations          Json     @default("[]")
  accounts           Json     @default("[]")
  raisedBy           String?  @map("raised_by") @db.Uuid
  triagedAt          String?  @map("triaged_at")
  triagedBy          String?  @map("triaged_by") @db.Uuid
  settledAt          String?  @map("settled_at")
  settledBy          String?  @map("settled_by") @db.Uuid
  mergedIntoSignalId String?  @map("merged_into_signal_id") @db.Uuid
  declineReason      String?  @map("decline_reason")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, signalKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, priority])
  @@index([tenantId, mergedIntoSignalId])
  @@map("improvement_signal")
}

/// ImprovementInitiative (P2-D30) — a proposed change, and the signals it was raised to answer.
/// `change_class` fixes how many distinct people must agree and is frozen once the initiative leaves the
/// drafting table, so a proposal cannot lower its own quorum on the way to a gate. `originating_signal_ids` is
/// a JSONB array rather than a join table because it is a fixed, ordered, bounded claim made at proposal time
/// and the lineage engine reports the gap when it is empty — a change nobody can trace to a filed problem is a
/// finding, not a constraint violation. `proposed_by` is never NULL: the rule that nobody approves their own
/// proposal has nothing to check against without it. `pilot_started_period` is an ordinal on the caller's grid,
/// not a date, because pilot length is subtraction and this domain holds no clock. Never deleted: an initiative
/// is rejected or withdrawn, and both are decisions the institution made. Tenant-owned: FORCE RLS.
model ImprovementInitiative {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  initiativeKey        String   @map("initiative_key")
  changeClass          String   @map("change_class")
  summary              String
  originatingSignalIds Json     @default("[]") @map("originating_signal_ids")
  status               String   @default("draft")
  proposedBy           String   @map("proposed_by") @db.Uuid
  submittedAt          String?  @map("submitted_at")
  reviewStartedAt      String?  @map("review_started_at")
  approvedAt           String?  @map("approved_at")
  pilotStartedAt       String?  @map("pilot_started_at")
  pilotStartedPeriod   Int?     @map("pilot_started_period")
  settledAt            String?  @map("settled_at")
  settledBy            String?  @map("settled_by") @db.Uuid
  withdrawalReason     String?  @map("withdrawal_reason")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdBy            String?  @map("created_by") @db.Uuid
  updatedBy            String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, initiativeKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, proposedBy])
  @@map("improvement_initiative")
}

/// GovernanceDecision (P2-D30) — the gate a change has to pass, and every ballot cast at it. This is where the
/// contract's rule that nothing self-modifies becomes a table: an initiative cannot move to approved, out of
/// pilot, or back out again, and a cycle cannot close, without a settled gate here. `initiative_id` names an
/// improvement initiative at the approval, pilot_exit and reversion gates and an improvement cycle at
/// cycle_closure — one column either way, because the gate says which kind of record it names and nothing
/// dereferences it blind. `change_class` and `proposed_by` are copied from the subject at convocation so the
/// quorum this gate faced and the ballot it must refuse stay readable without a join, and stay true even if the
/// subject is later amended. `ballots` is JSONB and ordered: `required`, `affirmed`, `outstanding`,
/// `conditional`, `refused` and `deferrals` are all a function of exactly that list. One open gate per subject
/// per kind is enforced by a PARTIAL unique index created in the migration. Never deleted. Tenant-owned:
/// FORCE RLS.
model GovernanceDecision {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  initiativeId   String   @map("initiative_id") @db.Uuid
  gate           String
  changeClass    String   @map("change_class")
  proposedBy     String   @map("proposed_by") @db.Uuid
  outcome        String   @default("pending")
  required       Int
  affirmed       Int      @default(0)
  outstanding    Int
  conditional    Int      @default(0)
  refused        Boolean  @default(false)
  deferrals      Int      @default(0)
  ballots        Json     @default("[]")
  convokedAt     String   @map("convoked_at")
  convokedBy     String?  @map("convoked_by") @db.Uuid
  settledAt      String?  @map("settled_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  // One gate of a kind may stand open against a subject at a time, enforced by a
  // PARTIAL unique index on (tenant_id, initiative_id, gate) WHERE outcome = 'pending',
  // created in the add_platform_evolution migration. Settled gates keep their row,
  // because a reversion convened after an earlier gate settled is a second decision
  // rather than a re-run of the first.
  @@index([tenantId, initiativeId])
  @@index([tenantId, initiativeId, gate])
  @@index([tenantId, outcome])
  @@map("governance_decision")
}

/// Lesson (P2-D30) — what the institution concluded, and whether it actually remembers it. The distinction
/// between `provisional` and `retained` is the reason this table exists rather than a notes field: a lesson
/// reaches memory only on a commitment that resolved against the knowledge graph, and the domain has no way to
/// decide that locally, which is exactly what stops a retrospective from marking its own conclusions
/// remembered. `retained_at_period` is an ordinal, and review falls due by subtraction from it. `areas` is
/// JSONB — the recognised capability areas the learning engine resolved, so a lesson can be found by what it
/// speaks to rather than by who filed it. `superseding_lesson_key` holds a key rather than an id because the
/// self-supersession rule is a key comparison and a reader must be able to follow the pointer without a join.
/// The unique on (tenant_id, lesson_key) is TOTAL and superseded lessons keep their key: a citation written
/// against the old conclusion still has to land somewhere. Never deleted. Tenant-owned: FORCE RLS.
model Lesson {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  lessonKey            String   @map("lesson_key")
  statement            String
  category             String
  origin               String
  originRef            String   @map("origin_ref")
  retention            String   @default("provisional")
  areas                Json     @default("[]")
  retainedAtPeriod     Int?     @map("retained_at_period")
  recordedBy           String?  @map("recorded_by") @db.Uuid
  retainedAt           String?  @map("retained_at")
  supersededAt         String?  @map("superseded_at")
  supersedingLessonKey String?  @map("superseding_lesson_key")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdBy            String?  @map("created_by") @db.Uuid
  updatedBy            String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, lessonKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, retention])
  @@index([tenantId, origin, originRef])
  @@map("lesson")
}

/// ImprovementCycle (P2-D30) — a round of improvement, bounded at both ends before it starts. `start_period`
/// and `end_period` are ordinals on the caller's grid and `periods` is the inclusive span the cadence engine
/// derived from them, stored rather than computed on read so a filed round keeps the length it was planned at.
/// `intent` freezes when review begins, because review judges the round against what it set out to do and an
/// editable intent would let a round be judged against what it turned out to achieve. `lessons_recorded` is
/// counted once at closure and is deliberately not a running total: a live count would make an open round look
/// productive on lessons nobody had yet committed. A cycle closes only behind a settled cycle_closure gate on
/// the governance table. Never deleted: a round is closed or abandoned, and an abandoned round with its reason
/// is the more instructive of the two. Tenant-owned: FORCE RLS.
model ImprovementCycle {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  cycleKey           String   @map("cycle_key")
  intent             String
  stage              String   @default("planning")
  startPeriod        Int      @map("start_period")
  endPeriod          Int      @map("end_period")
  periods            Int
  lessonsRecorded    Int      @default(0) @map("lessons_recorded")
  openedBy           String   @map("opened_by") @db.Uuid
  executionStartedAt String?  @map("execution_started_at")
  reviewStartedAt    String?  @map("review_started_at")
  settledAt          String?  @map("settled_at")
  settledBy          String?  @map("settled_by") @db.Uuid
  abandonmentReason  String?  @map("abandonment_reason")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, cycleKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, stage])
  @@index([tenantId, startPeriod, endPeriod])
  @@map("improvement_cycle")
}

/// MaturityAssessment (P2-D30) — where the institution stands across the ten capability areas, on a weighting
/// it declared before anything was scored. `weights` is JSONB and immutable from opening: an institution that
/// could reweight after seeing the readings would be scoring itself twice. `areas` holds every reading taken,
/// including the ones the engine does not count, because a reading with no evidence behind it is a fact about
/// the assessment worth keeping rather than an input to discard. `coverage` is reported areas over all ten and
/// never over the ones this assessment chose to weight, which is what stops an institution improving its
/// coverage by declaring fewer areas. `index` and `level` are derived and stored, and the event payloads
/// withhold both until publication so an unfinished reading cannot be quoted as a score. The unique on
/// (tenant_id, assessment_key) is TOTAL: a published assessment keeps its key, because a series that could
/// reissue one would let a later reading overwrite the comparison it was meant to be measured against.
/// Never deleted. Tenant-owned: FORCE RLS.
model MaturityAssessment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  assessmentKey  String   @map("assessment_key")
  period         Int
  weights        Json     @default("[]")
  areas          Json     @default("[]")
  publishable    Boolean  @default(false)
  index          Float
  level          String
  coverage       Float    @default(0)
  areasReported  Int      @default(0) @map("areas_reported")
  openedBy       String   @map("opened_by") @db.Uuid
  publishedAt    String?  @map("published_at")
  publishedBy    String?  @map("published_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, assessmentKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, period])
  @@index([tenantId, publishedAt])
  @@map("maturity_assessment")
}

/// AdoptionReview (P2-D30) — what an adopted change actually delivered, against what it promised. A review may
/// only open against an initiative that reached `adopted`, which is what makes the benefit claim answerable:
/// there is a decision behind it that named a quorum. `benefits` is JSONB and each entry carries its own
/// baseline, target, observation, promised and achieved movement, ratio and band — stored as measured rather
/// than re-derived on read, because the variance floors are platform constants that could move and a
/// recomputed band would rewrite what the institution concluded at the time. `verdict` is the severest measured
/// band's recommendation and `worst_band` is NULL when nothing could be measured, which is why
/// `benefits_measured` and `benefits_claimed` are separate columns: a review that claimed four benefits and
/// measured none is `inconclusive`, and a reader who saw only one count could not tell that from a review that
/// claimed nothing. One review per adopted change per period, TOTAL. Never deleted. Tenant-owned: FORCE RLS.
model AdoptionReview {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  initiativeId     String   @map("initiative_id") @db.Uuid
  reviewPeriod     Int      @map("review_period")
  benefits         Json     @default("[]")
  verdict          String   @default("inconclusive")
  worstBand        String?  @map("worst_band")
  benefitsMeasured Int      @default(0) @map("benefits_measured")
  benefitsClaimed  Int      @default(0) @map("benefits_claimed")
  openedAt         String   @map("opened_at")
  openedBy         String   @map("opened_by") @db.Uuid
  concludedAt      String?  @map("concluded_at")
  concludedBy      String?  @map("concluded_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, initiativeId, reviewPeriod])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, initiativeId])
  @@index([tenantId, verdict])
  @@index([tenantId, concludedAt])
  @@map("adoption_review")
}

/// ApiConsumer (P3-D01) — a named external integration and the terms it was admitted on. `credential_ref` is a
/// reference into the platform's secret store and never a secret: the value objects refuse anything that looks
/// like a key, a token or a bearer header, because a gateway is exactly where a leaked credential is worth the
/// most and a column that has ever held one has to be treated as compromised forever. `granted_scopes` is JSONB
/// on the aggregate rather than a child table, because admission asks one question — does this consumer hold the
/// scope this route requires — and a scope row that could be inserted on its own would widen a consumer's reach
/// without the consumer being rewritten. The unique on (tenant_id, consumer_key) is TOTAL and holds retired
/// consumers included: an audit trail, a delivery log and a support conversation all resolve an integration
/// through its key, and reissuing one under a new meaning is how those three come to disagree about who called.
/// `owner_id` is a person inside the institution who answers for the integration, and it is NOT NULL because an
/// integration nobody owns is the one that stays live years after the project that needed it ended.
/// `registered_by` is nullable, for the ones the platform provisioned itself. Never deleted: a consumer is
/// retired, and a retired consumer's key stays claimed. Tenant-owned: FORCE RLS.
model ApiConsumer {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  consumerKey      String   @map("consumer_key")
  displayName      String   @map("display_name")
  authScheme       String   @map("auth_scheme")
  credentialRef    String   @map("credential_ref")
  grantedScopes    String[] @map("granted_scopes")
  status           String   @default("registered")
  ownerId          String   @map("owner_id") @db.Uuid
  registeredBy     String?  @map("registered_by") @db.Uuid
  suspensionReason String?  @map("suspension_reason")
  activatedAt      String?  @map("activated_at")
  suspendedAt      String?  @map("suspended_at")
  retiredAt        String?  @map("retired_at")
  rotatedAt        String?  @map("rotated_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, consumerKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, ownerId])
  @@map("api_consumer")
}

/// ApiContract (P3-D01) — one version of one capability's published shape. The unique on (tenant_id,
/// capability_key, contract_version) is TOTAL and is the schema's half of the contract's central rule: a
/// published shape is immutable, so a change is a new version beside this row rather than an edit to it. An
/// integrator who built against a shape is entitled to keep finding it, and a version number that could be
/// reissued would make every client's pinned dependency a lie it cannot detect. `specification_ref` points at
/// the machine-readable specification in the document store; the specification itself is deliberately not here,
/// because a 200-kilobyte OpenAPI document in a row that admission reads on the hot path is a cost paid on every
/// request to serve a read nobody performs at request time. `superseded_by_version` is a version string and not
/// a foreign key: it names the successor an integrator should migrate to, and the successor may legitimately not
/// exist yet at the moment a deprecation is announced. Never deleted — draft, published, deprecated and sunset
/// are the whole lifecycle, and a sunset contract stays readable so a caller still holding it can be told
/// precisely what happened to what it was built against. Tenant-owned: FORCE RLS.
model ApiContract {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  capabilityKey       String   @map("capability_key")
  contractVersion     String   @map("contract_version")
  title               String
  summary             String
  style               String   @default("rest")
  status              String   @default("draft")
  specificationRef    String   @map("specification_ref")
  publishedAt         String?  @map("published_at")
  publishedBy         String?  @map("published_by") @db.Uuid
  deprecatedAt        String?  @map("deprecated_at")
  sunsetAt            String?  @map("sunset_at")
  supersededByVersion String?  @map("superseded_by_version")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, capabilityKey, contractVersion])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, capabilityKey])
  @@index([tenantId, sunsetAt])
  @@map("api_contract")
}

/// CapabilityRoute (P3-D01) — one addressable operation on a published contract, and the only table in the
/// platform that knows which internal capability answers an external address. `internal_target` is the reason
/// this table exists and the reason nothing may project it: the contract's rule is that the platform exposes
/// capabilities and never implementation, so no view, event or error carries this column, and a consumer
/// therefore cannot acquire a dependency on where a capability currently lives. The domain behind a route can be
/// split, renamed or moved and the only row that changes is this one.
///
/// One unique is PARTIAL, which is why it is in the add_gateway migration and not expressible here (like RLS, a
/// migration-only feature). Two routes may not answer at one address:
/// UNIQUE (tenant_id, method, external_path) WHERE status <> 'retired'. It is partial rather than total because
/// a retired route keeps its row — the retirement is the record of an address having once meant something else,
/// and a total unique would either force that history to be deleted or make an address unreusable for the life
/// of the institution. `path_parameters` is derived from `external_path` at registration and stored, so the
/// binding a router performs does not re-parse a template on every request. `idempotent` says whether this route
/// demands an idempotency key, which is why the ledger and the router agree without consulting each other.
/// Tenant-owned: FORCE RLS.
model CapabilityRoute {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  contractId      String   @map("contract_id") @db.Uuid
  capabilityKey   String   @map("capability_key")
  contractVersion String   @map("contract_version")
  method          String
  externalPath    String   @map("external_path")
  pathParameters  String[] @map("path_parameters")
  style           String   @default("rest")
  status          String   @default("draft")
  requiredScope   String   @map("required_scope")
  internalTarget  String   @map("internal_target")
  idempotent      Boolean  @default(false)
  activatedAt     String?  @map("activated_at")
  retiredAt       String?  @map("retired_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, contractId])
  // Two routes may not answer at one address, enforced by a PARTIAL unique index on
  // (tenant_id, method, external_path) WHERE status <> 'retired', created in the
  // add_gateway migration. Retired routes keep their row, so an address that once
  // meant something else stays on the record and can later be reissued.
  @@index([tenantId, method, externalPath])
  @@map("capability_route")
}

/// TrafficPolicy (P3-D01) — which numbers apply to which caller. This table holds limits and nothing else: it
/// counts no requests and decides nothing about a live one, because counting belongs to the shared rate limiter
/// the platform already owns and deciding belongs to the admission engine. What is settled here is the question
/// neither of those can answer alone — *which limits apply to this call* — as a row an operator can read, change
/// and be held to.
///
/// `limits` is JSONB holding requests-per-window, the window, the burst allowance, the payload ceiling and the
/// timeout, every one of them nullable and an unset one unenforced. It is one column rather than five because
/// the coherence rules run across them: half a rate limit — a count with no window, or a window with no count —
/// is refused by the aggregate, and a five-column shape invites a migration that adds a sixth limit to only some
/// of the rows.
///
/// One unique is PARTIAL and, uniquely in this schema, NULLS NOT DISTINCT — see the add_gateway migration. One
/// active policy may exist per scope tuple: UNIQUE (tenant_id, scope, consumer_id, capability_key) NULLS NOT
/// DISTINCT WHERE active. The NULLS NOT DISTINCT clause is the load-bearing half. A `global` policy names
/// neither a consumer nor a capability and a `capability` policy names no consumer, so under Postgres's default
/// NULLS DISTINCT two active global policies would both satisfy an ordinary unique and the resolver would
/// silently apply whichever it found first — the exact failure the aggregate's scope/subject coherence check
/// exists to prevent, arrived at through the database instead. It is partial on `active` because a deactivated
/// policy keeps its row: an operator has to be able to see the limits that used to be in force during the
/// incident they are reading about. Tenant-owned: FORCE RLS.
model TrafficPolicy {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scope          String
  consumerId     String?  @map("consumer_id") @db.Uuid
  capabilityKey  String?  @map("capability_key")
  displayName    String   @map("display_name")
  limits         Json     @default("{}")
  active         Boolean  @default(true)
  deactivatedAt  String?  @map("deactivated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, active])
  // One active policy per scope tuple, enforced by a PARTIAL unique index on
  // (tenant_id, scope, consumer_id, capability_key) NULLS NOT DISTINCT WHERE active,
  // created in the add_gateway migration. NULLS NOT DISTINCT is required rather than
  // stylistic: global and capability policies leave consumer_id NULL, and under the
  // default NULLS DISTINCT two active global policies would not collide.
  @@index([tenantId, scope, consumerId, capabilityKey])
  @@map("traffic_policy")
}

/// IntegrationEndpoint (P3-D01) — an external system the platform calls out to, described as a protocol, an
/// adapter key and a credential *reference*. There is no URL, no header set and no client configuration here,
/// and that is the point: `adapter_key` names the adapter that knows how to reach the system, the adapter is
/// resolved at the composition root, and the vendor behind it can be replaced without one row of this table
/// changing meaning. `credential_ref` is nullable because some protocols are anonymous, and it is never a secret.
///
/// `posture`, `consecutive_failures` and `posture_since` are the circuit breaker's *record*, not its
/// implementation — runtime breaking belongs to the reliability package. They are stored because the decision
/// has to survive a process restart: a breaker whose state lives only in memory reopens the floodgates on every
/// deploy, and the failing vendor gets the stampede a second time. `posture_since` is NOT NULL and is set at
/// registration, because a half-open probe is decided by how long the posture has held and a NULL would make
/// that arithmetic unanswerable at exactly the moment it matters.
///
/// `health` and `status` are separate on purpose and answer different questions. `status` is the institution's
/// intent — registered, active, quarantined, disabled, retired — and only a person changes it. `health` is what
/// the platform has observed. An endpoint the vendor has broken is `active` and `unreachable`; one the
/// institution has switched off is `disabled` whatever its last reading said, and its failures stop being
/// counted against anyone. The unique on (tenant_id, endpoint_key) is TOTAL: a delivery log resolves an endpoint
/// through its key long after the endpoint is retired. Tenant-owned: FORCE RLS.
model IntegrationEndpoint {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  endpointKey         String   @map("endpoint_key")
  displayName         String   @map("display_name")
  protocol            String
  adapterKey          String   @map("adapter_key")
  credentialRef       String?  @map("credential_ref")
  status              String   @default("registered")
  health              String   @default("unknown")
  posture             String   @default("closed")
  consecutiveFailures Int      @default(0) @map("consecutive_failures")
  postureSince        String   @map("posture_since")
  circuitOpenedAt     String?  @map("circuit_opened_at")
  lastOutcomeAt       String?  @map("last_outcome_at")
  activatedAt         String?  @map("activated_at")
  quarantinedAt       String?  @map("quarantined_at")
  disabledAt          String?  @map("disabled_at")
  disabledReason      String?  @map("disabled_reason")
  retiredAt           String?  @map("retired_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, endpointKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, posture])
  @@index([tenantId, adapterKey])
  @@map("integration_endpoint")
}

/// WebhookSubscription (P3-D01) — one integration's standing request to be told when something happens.
/// `event_types` is TEXT[] and deliberately carries no GIN index. Under FORCE RLS the tenant predicate arrives as
/// a security qual, and PostgreSQL will not evaluate a non-leakproof qual ahead of one; array containment (`@>`)
/// is not leakproof, so on a policy-protected table it can never be an index condition and is always demoted to a
/// filter. The add_gateway migration records the measurement. The interest predicate is pure and lives on the
/// aggregate; the adapter pushes the same decision into SQL as a containment test, and the two are required to
/// agree. At an institution's cardinality the read is served by (tenant_id, organization_id, status).
///
/// `secret_ref` is a reference to the signing secret and never the secret, so rotating one is a write to the
/// vault and an updated_at here. `consecutive_failures` is the subscription's own count and is deliberately
/// separate from the endpoint's: several subscriptions may share an endpoint, and a subscription whose own
/// receiver is refusing everything should be suspended without penalising the others that are healthy on the
/// same connection.
///
/// `status` distinguishes paused from suspended, which is the distinction an operator needs most. Paused is the
/// institution's choice and resumes on request; suspended is the platform's, carries the reason it decided, and
/// exists so that a receiver which has been failing for a week stops generating deliveries nobody will ever
/// accept. Revoked is terminal and keeps its row, because the deliveries it produced are still in the log and
/// still have to resolve to the subscription that asked for them. The unique on (tenant_id, consumer_id,
/// subscription_key) is TOTAL for the same reason. Tenant-owned: FORCE RLS.
model WebhookSubscription {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  consumerId          String   @map("consumer_id") @db.Uuid
  subscriptionKey     String   @map("subscription_key")
  displayName         String   @map("display_name")
  endpointId          String   @map("endpoint_id") @db.Uuid
  eventTypes          String[] @map("event_types")
  deliveryMode        String   @default("at_least_once") @map("delivery_mode")
  secretRef           String?  @map("secret_ref")
  status              String   @default("active")
  consecutiveFailures Int      @default(0) @map("consecutive_failures")
  lastDeliveryAt      String?  @map("last_delivery_at")
  lastSuccessAt       String?  @map("last_success_at")
  pausedAt            String?  @map("paused_at")
  suspendedAt         String?  @map("suspended_at")
  suspendedReason     String?  @map("suspended_reason")
  revokedAt           String?  @map("revoked_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, consumerId, subscriptionKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, consumerId])
  @@index([tenantId, endpointId])
  @@map("webhook_subscription")
}

/// OutboundDelivery (P3-D01) — one attempt-bearing record of one event owed to one subscription. This table
/// holds the *schedule* and not the mechanism: nothing here opens a socket, signs a body or sleeps until the
/// next attempt, because delivery mechanics belong to the jobs package and the transactional outbox belongs to
/// the events package. What this row settles is when the next attempt is due and how many remain, and it settles
/// it as a pure function of the delivery's own identity — retry jitter is a hash of the id, so a schedule is
/// reproducible in a support conversation and two thousand deliveries created in the same second do not retry in
/// the same millisecond.
///
/// `payload_fingerprint` is a digest and never a payload. The event body lives wherever the publishing domain
/// put it; a copy here would make this table the largest in the platform, and one that has to be encrypted at
/// rest because it would then contain student data.
///
/// One unique is PARTIAL — see the add_gateway migration. An event is owed to a subscription once:
/// UNIQUE (tenant_id, subscription_id, event_id) WHERE replay_of_delivery_id IS NULL. The predicate is what lets
/// an operator replay a dead letter at all: the replay is a new row naming the same event, and a total unique
/// would make the recovery path unrepresentable. It also means a re-dispatch of an event already owed is
/// refused by the original row rather than by the replay, which is the behaviour the dedupe read was shaped
/// around. `last_error` is truncated by the aggregate before it arrives, because a vendor that returns its
/// entire HTML error page should not be able to decide the size of this table. Tenant-owned: FORCE RLS.
model OutboundDelivery {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  subscriptionId     String   @map("subscription_id") @db.Uuid
  endpointId         String   @map("endpoint_id") @db.Uuid
  eventType          String   @map("event_type")
  eventId            String   @map("event_id") @db.Uuid
  payloadFingerprint String   @map("payload_fingerprint")
  deliveryMode       String   @default("at_least_once") @map("delivery_mode")
  outcome            String   @default("pending")
  attempts           Int      @default(0)
  nextAttemptAt      String?  @map("next_attempt_at")
  lastAttemptedAt    String?  @map("last_attempted_at")
  lastStatusCode     Int?     @map("last_status_code")
  lastError          String?  @map("last_error")
  deliveredAt        String?  @map("delivered_at")
  deadLetteredAt     String?  @map("dead_lettered_at")
  abandonedAt        String?  @map("abandoned_at")
  abandonedReason    String?  @map("abandoned_reason")
  replayOfDeliveryId String?  @map("replay_of_delivery_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, outcome])
  @@index([tenantId, subscriptionId])
  @@index([tenantId, endpointId])
  @@index([tenantId, outcome, nextAttemptAt])
  @@index([tenantId, replayOfDeliveryId])
  // An event is owed to a subscription once, enforced by a PARTIAL unique index on
  // (tenant_id, subscription_id, event_id) WHERE replay_of_delivery_id IS NULL,
  // created in the add_gateway migration. The predicate is what makes replaying a
  // dead letter representable at all.
  @@index([tenantId, subscriptionId, eventId])
  @@map("outbound_delivery")
}

/// IdempotencyRecord (P3-D01) — the platform's memory that a named operation has already been attempted, and
/// what came of it. This is the hottest table in the package: one row per guarded write, on every mutating
/// request the institution serves.
///
/// The unique on (tenant_id, consumer_id, idempotency_key) is TOTAL and is the constraint the whole module
/// rests on — it is what resolves a race between two nodes that both read nothing and both decide to proceed.
/// It is deliberately NOT partial on expiry, for a reason worth stating because the alternative looks
/// attractive: a partial index would need `WHERE expires_at > now()`, and Postgres cannot index on a
/// non-immutable function. A row therefore holds its key for good, which is exactly why the aggregate offers
/// renewal — a request that legitimately recycles a key after retention rewrites the expired row rather than
/// inserting beside it, and the sweep that would eventually have removed it is free to run late without
/// changing an answer the ledger gives.
///
/// `idempotency_key` is the caller's own opaque token, trimmed and otherwise preserved — case included, and
/// checked against no grammar — because a support conversation about a duplicate charge has to be about the same
/// string on both sides of it. `payload_fingerprint` is a digest, so a key reused across two different requests
/// is detectable without this table holding either request. `response_ref` points at the stored response and is
/// never the response, which keeps a replay cheap and keeps student data out of a table this wide.
/// `expires_at` is NOT NULL and computed from the instant the caller handed in, never from a clock in the
/// engine. Tenant-owned: FORCE RLS.
model IdempotencyRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  consumerId         String   @map("consumer_id") @db.Uuid
  idempotencyKey     String   @map("idempotency_key")
  capabilityKey      String   @map("capability_key")
  method             String
  payloadFingerprint String   @map("payload_fingerprint")
  state              String   @default("in_flight")
  recordedStatus     Int?     @map("recorded_status")
  responseRef        String?  @map("response_ref")
  completedAt        String?  @map("completed_at")
  conflictedAt       String?  @map("conflicted_at")
  expiresAt          String   @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, consumerId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, consumerId])
  @@index([tenantId, organizationId])
  @@index([tenantId, expiresAt])
  @@map("idempotency_record")
}

/// EventTypeDefinition (P3-D02) — one version of one event's payload shape, and the compatibility promise made
/// about it. The unique on (tenant_id, event_type_key, version) is TOTAL and is the schema's half of the rule
/// the compatibility engine rests on: a published shape is frozen, so a change is a new version beside this row
/// rather than an edit to it. A consumer written against version N holds a dependency it cannot see being
/// rewritten, and a version number that could be reissued would make every such dependency a lie the consumer
/// has no way to detect. `superseded_by_version` is an integer and not a foreign key: it names the version a
/// producer should move to, and at the moment a deprecation is announced that version may legitimately not
/// exist yet.
///
/// `schema_fields` is JSONB rather than a child table, and the reason is the same one that keeps every other
/// child in this contract inside its aggregate — a field row that could be inserted on its own would change an
/// event's shape without the definition being rewritten, which is precisely the change the compatibility engine
/// exists to judge. The shape is a small closed set of seven field types rather than JSON Schema, because the
/// engine has to answer whether a consumer written against version N can read version N+1, and that question is
/// decidable only over a decidable schema language. Never deleted: draft, published, deprecated and retired are
/// the whole lifecycle, and a retired definition stays readable so a message recorded years ago can still be
/// explained. Tenant-owned: FORCE RLS.
model EventTypeDefinition {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  eventTypeKey        String   @map("event_type_key")
  version             Int      @default(1)
  title               String
  summary             String
  compatibilityMode   String   @default("backward") @map("compatibility_mode")
  status              String   @default("draft")
  schemaFields        Json     @default("[]") @map("schema_fields")
  publishedAt         String?  @map("published_at")
  publishedBy         String?  @map("published_by") @db.Uuid
  deprecatedAt        String?  @map("deprecated_at")
  retireAt            String?  @map("retire_at")
  supersededByVersion Int?     @map("superseded_by_version")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, eventTypeKey, version])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, eventTypeKey])
  @@map("event_type_definition")
}

/// EventStream (P3-D02) — one named ordered channel, the types it accepts, and how much of each message it
/// keeps. The unique on (tenant_id, stream_key) is TOTAL and holds retired streams included: a message, a
/// binding, a subscription, a checkpoint and a replay all resolve a stream through its key, and reissuing one
/// under a new meaning is how those five come to disagree about what was published where.
///
/// `event_type_keys` is TEXT[] and deliberately carries no GIN index, for the reason the gateway migration
/// already established about webhook_subscription.event_types. Under FORCE RLS the tenant predicate arrives as
/// a security qual, and PostgreSQL will not evaluate a qual whose operator is not leakproof ahead of one — that
/// would let the qual read a row the policy has not yet admitted. Array containment (@>) and overlap (&&) are
/// both non-leakproof, so on a policy-protected table a containment test can never become an index condition.
/// A GIN index here would cost write amplification on every stream write, be read zero times, and leave the
/// schema looking as though the accepts-this-type read were served when it is not. What serves it instead is
/// cardinality: an institution's streams number in the tens, so the whole set is a page or two and the read
/// completes without consulting an index at all. Giving event types a table of their own would make the qual a
/// leakproof equality and would also make a row able to widen a stream's acceptance without the stream being
/// rewritten, which is the invariant this column exists to keep.
///
/// `partition_count` and `partition_key_path` are on the stream rather than derived per message because
/// repartitioning is an act with a date: a message records the count that was in force when it was published,
/// so the partition it landed on stays explicable after the stream is widened. `retention_seconds` is what the
/// sweep reads and `retention` is what a replay's admissibility is judged on — a stream keeping digests cannot
/// be replayed no matter how long it keeps them. Tenant-owned: FORCE RLS.
model EventStream {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  streamKey        String   @map("stream_key")
  title            String
  summary          String
  status           String   @default("draft")
  ordering         String   @default("partition")
  partitionCount   Int      @default(8) @map("partition_count")
  partitionKeyPath String?  @map("partition_key_path")
  retention        String   @default("digest")
  retentionSeconds Int      @default(2592000) @map("retention_seconds")
  eventTypeKeys    String[] @map("event_type_keys")
  activatedAt      String?  @map("activated_at")
  activatedBy      String?  @map("activated_by") @db.Uuid
  retiredAt        String?  @map("retired_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, streamKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  @@map("event_stream")
}

/// StreamBinding (P3-D02) — which backbone actually carries one stream, and in what state. `transport_ref` is a
/// reference into configuration or the secret store and never a broker credential, for the reason the gateway's
/// credential_ref columns exist: a column that has ever held a secret has to be treated as compromised forever,
/// and rotating one should be a write to the vault and an updated_at here.
///
/// Two constraints, and only one of them is expressible in this file. The unique on (tenant_id, stream_key,
/// transport) is TOTAL and holds in every state including retired, because re-declaring a stream on a backbone
/// it was once bound to is how a drained migration silently becomes a double-delivery. The second is PARTIAL
/// and therefore lives in the add_event_mesh migration: UNIQUE (tenant_id, stream_key) WHERE status = 'active'.
/// At most one binding per stream may be carrying, which is what keeps the stream single-writer and therefore
/// what makes its sequence a sequence. The domain enforces it too, and the two are not redundant — the domain
/// check is a read followed by a write, and a database that cannot refuse the second writer turns a swap
/// performed during a deployment into two brokers both believing they own the ordering. It is partial rather
/// than total because declared, draining and retired bindings all keep their rows: a swap is precisely the
/// interval in which two bindings exist on one stream, and only one of them is active.
///
/// No separate index on (tenant_id, stream_key) — the total unique above leads with those two columns and
/// serves the by-stream read. Tenant-owned: FORCE RLS.
model StreamBinding {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  streamKey      String   @map("stream_key")
  transport      String   @default("outbox")
  transportRef   String   @map("transport_ref")
  status         String   @default("declared")
  activatedAt    String?  @map("activated_at")
  activatedBy    String?  @map("activated_by") @db.Uuid
  drainingSince  String?  @map("draining_since")
  retiredAt      String?  @map("retired_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, streamKey, transport])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
  // At most one binding per stream may carry, enforced by a PARTIAL unique index on
  // (tenant_id, stream_key) WHERE status = 'active', created in the add_event_mesh
  // migration. Declared, draining and retired bindings keep their rows, because a
  // swap is exactly the interval in which two bindings exist on one stream.
  @@map("stream_binding")
}

/// MeshSubscription (P3-D02) — one consumer's standing interest in one stream, and the promise the mesh made it
/// about delivery. The unique on (tenant_id, subscription_key) is TOTAL and holds retired subscriptions
/// included, for the reason every other key in this contract is total: a checkpoint, a dead letter and a replay
/// all name a subscription, and those records outlive the consumer that produced them.
///
/// `filter` is JSONB rather than a child table because a predicate row that could be inserted on its own would
/// widen or narrow a consumer's interest without the subscription being rewritten — and narrowing is the
/// dangerous direction, since a consumer that silently stops being offered a class of event looks exactly like
/// a class of event that stopped happening. `semantics` and `max_attempts` sit together because they are read
/// together: exactly-once obliges the mesh to keep a deduplication ledger for this consumer, and the attempt
/// budget is what decides when a failing delivery becomes a dead letter rather than a retry.
///
/// The index on (tenant_id, stream_key, status) serves both stream-scoped reads — every subscription on a
/// stream, and the deliverable subset a dispatch fans out to — which is the read the mesh performs most often
/// and the only one on its hot path. Tenant-owned: FORCE RLS.
model MeshSubscription {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  subscriptionKey String   @map("subscription_key")
  streamKey       String   @map("stream_key")
  consumerGroup   String   @map("consumer_group")
  title           String
  semantics       String   @default("at_least_once")
  maxAttempts     Int      @default(5) @map("max_attempts")
  filter          Json     @default("[]")
  status          String   @default("registered")
  activatedAt     String?  @map("activated_at")
  activatedBy     String?  @map("activated_by") @db.Uuid
  pausedAt        String?  @map("paused_at")
  retiredAt       String?  @map("retired_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, subscriptionKey])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, streamKey, status])
  @@map("mesh_subscription")
}

/// SubscriptionCheckpoint (P3-D02) — how far one consumer has got through one partition. The unique on
/// (tenant_id, subscription_id, partition) is TOTAL and is the whole of the table's integrity: a consumer with
/// two checkpoints on one partition has two answers to the only question this table exists to answer, and the
/// one a dispatch happens to read decides whether an event is delivered twice or not at all.
///
/// `committed_position` moves forward and is refused backwards by the aggregate, because a position that can
/// regress turns at-least-once into a redelivery storm nobody asked for. A deliberate rewind is therefore not a
/// smaller number written over the old one but a reset: `reset_at`, `reset_by` and `reset_reason` are all NOT
/// NULL together or NULL together, and the reason is required because rewinding a live consumer re-delivers
/// everything after the new position to a system that has already acted on it. `position_moved_at` is NOT NULL
/// and set when the checkpoint opens, because lag is measured from it and a NULL would make a consumer that has
/// never committed indistinguishable from one that committed at an unknown time — which are opposite
/// diagnoses. `subscription_key` and `stream_key` are denormalised off the subscription so an operator reading
/// a lag report is not required to join to learn what is behind. Tenant-owned: FORCE RLS.
model SubscriptionCheckpoint {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  subscriptionId    String   @map("subscription_id") @db.Uuid
  subscriptionKey   String   @map("subscription_key")
  streamKey         String   @map("stream_key")
  partition         Int
  committedPosition Int      @map("committed_position")
  positionMovedAt   String   @map("position_moved_at")
  resetAt           String?  @map("reset_at")
  resetBy           String?  @map("reset_by") @db.Uuid
  resetReason       String?  @map("reset_reason")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @map("created_by") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, subscriptionId, partition], map: "subscription_checkpoint_partition_key")
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("subscription_checkpoint")
}

/// MeshMessage (P3-D02) — one fact the mesh accepted, at the position it was accepted at. This is the largest
/// table the contract adds and the only one on the publish path, and two TOTAL uniques carry everything the
/// mesh promises about it.
///
/// (tenant_id, event_id) is the deduplication ledger. A producer that retries after a timeout it never learned
/// the outcome of publishes the same event twice, and this constraint is what makes the second attempt a no-op
/// instead of a second fact. It is total because an event id means one occurrence for the life of the
/// institution, not for a retention window.
///
/// (tenant_id, stream_key, sequence) is what makes a sequence a sequence. Allocating the next position is a
/// read followed by a write, and two publishers that both read the same head both decide to write the same
/// number; the domain cannot see that happen and the database can. Losing the race is not an error the caller
/// should see, so the adapter re-reads and retries rather than surfacing it — which is only sound because this
/// constraint exists to lose the race against.
///
/// `recorded_at`, `occurred_at` and every other instant is TEXT in fixed-width ISO-8601 with milliseconds and a
/// `Z`, normalised on write by the domain's fixedWidthInstant. That is load-bearing rather than cosmetic here:
/// replay windows and the retention sweep both range-compare `recorded_at` in the database, ISO-8601 admits
/// several spellings of one moment whose lexical order is not their chronological order, and the deployment
/// collation is C.UTF-8 so byte order is code-point order. Fixed width is what makes a text btree a
/// chronological index. `partition_count` records the count that was in force at publication, so a message's
/// partition stays explicable after the stream is widened.
///
/// `payload` is JSONB and nullable, and `payload_digest` is a digest and never a payload. A stream keeping
/// `none` or `digest` retention holds no payload at all, and `payload_forgotten_at` records an erasure
/// performed under a data-protection request — which is why forgetting is a column here rather than a delete:
/// the fact that an event occurred is not erased when its contents are. Tenant-owned: FORCE RLS.
model MeshMessage {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  streamKey          String   @map("stream_key")
  partition          Int
  partitionCount     Int      @map("partition_count")
  partitionKey       String   @map("partition_key")
  sequence           Int
  eventId            String   @map("event_id") @db.Uuid
  eventTypeKey       String   @map("event_type_key")
  eventTypeVersion   Int      @map("event_type_version")
  aggregateType      String   @map("aggregate_type")
  aggregateId        String   @map("aggregate_id") @db.Uuid
  producerKey        String   @map("producer_key")
  correlationId      String   @map("correlation_id")
  causationId        String?  @map("causation_id") @db.Uuid
  traceId            String   @map("trace_id")
  occurredAt         String   @map("occurred_at")
  recordedAt         String   @map("recorded_at")
  retention          String   @default("digest")
  payloadDigest      String?  @map("payload_digest")
  payload            Json?
  payloadForgottenAt String?  @map("payload_forgotten_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by") @db.Uuid
  updatedBy          String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, eventId])
  @@unique([tenantId, streamKey, sequence])
  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, streamKey, partition, sequence])
  @@index([tenantId, streamKey, recordedAt])
  @@map("mesh_message")
}

/// DeadLetter (P3-D02) — one delivery the mesh gave up on, and what somebody decided about it. Every column
/// describing the failure is copied from the subscription and the message rather than supplied by the delivery
/// loop, which supplies only the four facts it alone holds: which reason, how many attempts, which trace, and
/// when the last attempt failed. A record read months later by somebody reconstructing what was lost cannot
/// then contradict the code that failed to deliver it.
///
/// The unique is PARTIAL and lives in the add_event_mesh migration: UNIQUE (tenant_id, subscription_id,
/// message_id) WHERE status = 'open'. Partial is the whole point. Two failures of one message separated by a
/// settlement are two rows, because they are two events and collapsing them would erase the fact that somebody
/// intervened in between. But a consumer restarted every ninety seconds against a message it will never process
/// would otherwise fill the morning worklist with a thousand rows describing one broken projector, so while
/// nothing has been decided a repeat failure is the same undecided work item. The domain returns the open
/// record unchanged; this index is what makes that hold when two delivery workers race.
///
/// The index on (tenant_id, subscription_id, message_id) is the total counterpart the partial unique cannot
/// serve — the by-message read has to find settled records too — and it leads with the columns the
/// by-subscription read needs, so no separate index for that. (tenant_id, organization_id, status, failed_at)
/// carries the worklist read including its ordering, which is oldest failure first because that is the one that
/// has been costing the institution longest. Tenant-owned: FORCE RLS.
model DeadLetter {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  subscriptionId  String   @map("subscription_id") @db.Uuid
  subscriptionKey String   @map("subscription_key")
  streamKey       String   @map("stream_key")
  messageId       String   @map("message_id") @db.Uuid
  eventId         String   @map("event_id") @db.Uuid
  eventTypeKey    String   @map("event_type_key")
  partition       Int
  sequence        Int
  reason          String
  attempts        Int
  traceId         String   @map("trace_id")
  failedAt        String   @map("failed_at")
  status          String   @default("open")
  settledAt       String?  @map("settled_at")
  settledBy       String?  @map("settled_by") @db.Uuid
  discardReason   String?  @map("discard_reason")
  replayId        String?  @map("replay_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status, failedAt])
  // One undecided record per message per consumer, enforced by a PARTIAL unique index
  // on (tenant_id, subscription_id, message_id) WHERE status = 'open', created in the
  // add_event_mesh migration. Settled records keep their rows, so a message that failed,
  // was settled and failed again is two rows rather than one overwritten one.
  @@index([tenantId, subscriptionId, messageId])
  @@map("dead_letter")
}

/// ReplayRequest (P3-D02) — a request to send a stretch of a stream to a consumer again, and the decisions made
/// about it. Replaying is the most consequential thing the mesh can be asked to do — it delivers facts a
/// consumer has already acted on to a consumer that will act on them again — so the row records not just the
/// window but who asked, who agreed, how many messages they were told it covered, and how many actually went.
/// `message_count` is the estimate shown to the approver and `delivered_count` is what the run reported, and
/// they are separate columns because a run that delivered a different number than was approved is the single
/// most useful thing this table can tell an investigator.
///
/// The unique is PARTIAL and lives in the add_event_mesh migration: UNIQUE (tenant_id, subscription_id) WHERE
/// status = 'running'. Two replays into one consumer interleave two stretches of history in an order neither
/// requester asked for, and the consumer — written to read a stream forwards — cannot tell it is being handed
/// two. Nothing errors while it happens: both runs report themselves complete, and what is left is a projection
/// built from a sequence of facts that never occurred in that order. The domain refuses the second start; this
/// index is what makes the refusal hold when two operators press the button at once. It is partial because
/// every other status may repeat freely — a consumer may have a hundred completed replays and one requested.
///
/// `from_instant` and `to_instant` are fixed-width ISO-8601 for the same reason mesh_message.recorded_at is:
/// they are compared against that column, and a window whose bounds sort differently from the messages inside
/// it selects the wrong messages. Tenant-owned: FORCE RLS.
model ReplayRequest {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  subscriptionId   String   @map("subscription_id") @db.Uuid
  subscriptionKey  String   @map("subscription_key")
  streamKey        String   @map("stream_key")
  fromInstant      String   @map("from_instant")
  toInstant        String   @map("to_instant")
  reason           String
  status           String   @default("requested")
  requestedBy      String   @map("requested_by") @db.Uuid
  approvedBy       String?  @map("approved_by") @db.Uuid
  approvedAt       String?  @map("approved_at")
  messageCount     Int?     @map("message_count")
  startedAt        String?  @map("started_at")
  settledAt        String?  @map("settled_at")
  settledBy        String?  @map("settled_by") @db.Uuid
  settlementReason String?  @map("settlement_reason")
  deliveredCount   Int?     @map("delivered_count")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  @@index([tenantId])
  @@index([tenantId, organizationId])
  // One running replay per consumer, enforced by a PARTIAL unique index on
  // (tenant_id, subscription_id) WHERE status = 'running', created in the
  // add_event_mesh migration. Every other status may repeat freely, so a
  // consumer may hold a hundred completed replays and one requested.
  @@index([tenantId, subscriptionId])
  @@map("replay_request")
}
