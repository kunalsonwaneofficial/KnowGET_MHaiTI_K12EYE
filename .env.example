# KnowGET MHaiTI — example environment configuration.
# Copy to `.env` and adjust. NEVER commit a real `.env`.

# Runtime
NODE_ENV=development

# API (apps/api)
API_PORT=4000
API_HOST=0.0.0.0

# Web (apps/web)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Admin (apps/admin)
ADMIN_PORT=3001

# Database (foundation for P1-M03 — Enterprise Data Platform)
DATABASE_URL=postgresql://knowget:knowget@localhost:5432/knowget_mhaiti?schema=public
POSTGRES_USER=knowget
POSTGRES_PASSWORD=knowget
POSTGRES_DB=knowget_mhaiti

# Cache (foundation for P1-M05 — Shared Services / caching)
REDIS_URL=redis://localhost:6379
